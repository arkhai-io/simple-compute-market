**
!.dist/
!.dist/*.whl
!domains/vms/provisioning/iac/
!domains/vms/provisioning/iac/**
!domains/bare_metal/provisioning/iac/
!domains/bare_metal/provisioning/iac/**
!provisioning/compute/service/pyproject.toml
!provisioning/compute/service/uv.lock
!scripts/
!scripts/uv_project.py

# A .dockerignore beside a Dockerfile replaces the root one, so none of the root's
# exclusions apply here. The IaC trees admitted whole above leave out what a
# checkout generates or holds locally: environments and caches, Ansible logs and
# retry files, and what the VM IaC tree's own .gitignore ignores, an operator's
# keys, credentials, inventories, and variable files, and Terraform's variables,
# state, plans, and working directories.
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.log
**/*.retry
domains/vms/provisioning/iac/credentials
domains/vms/provisioning/iac/ansible/credentials
domains/vms/provisioning/iac/ansible/keys/*
!domains/vms/provisioning/iac/ansible/keys/.gitignore
domains/vms/provisioning/iac/ansible/inventory/hosts*
domains/vms/provisioning/iac/ansible/inventory/provisioning-hosts*
!domains/vms/provisioning/iac/ansible/inventory/hosts.example
!domains/vms/provisioning/iac/ansible/inventory/provisioning-hosts.example
domains/vms/provisioning/iac/ansible/inventory/management-vars.yaml
domains/vms/provisioning/iac/ansible/build-vars*.yaml
domains/vms/provisioning/iac/ansible/playbooks/frp-server-credentials*
domains/vms/provisioning/iac/terraform/*/*.tfvars
domains/vms/provisioning/iac/terraform/*/*.tfstate
domains/vms/provisioning/iac/terraform/*/*.tfstate.backup
domains/vms/provisioning/iac/terraform/*/.terraform*
domains/vms/provisioning/iac/terraform/*/*.plan
