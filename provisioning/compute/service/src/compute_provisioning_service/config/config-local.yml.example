# ---------------------------------------------------------------------------
# Profile: local
# Copy this file to config-local.yml and set ACTIVE_PROFILES=local in .env.
# config-local.yml is gitignored and never committed.
# ---------------------------------------------------------------------------

# Uncomment to use PostgreSQL instead of the default SQLite:
# database_url: "postgresql+psycopg2://postgres:postgres@localhost:5432/provisioning"

# Override Ansible paths to your local checkout of domains/vms/provisioning/iac:
# playbook_path: "/home/you/code/domains/vms/provisioning/iac/ansible/playbooks/single-tenant/vm-operations.yaml"
# inventory_path: "/home/you/code/domains/vms/provisioning/iac/ansible/inventory/hosts"
# management_vars_path: "/home/you/code/domains/vms/provisioning/iac/ansible/inventory/management-vars.yaml"

# Public marketplace identity and exact storefront trust pin. Supply the
# matching service signer only through ARKHAI_IDENTITY_CREDENTIAL.
# storefront_site_id: "default"
# identity:
#   scheme: "ed25519"
#   identifier: "<unpadded-base64url-public-key>"
# storefront_identity:
#   scheme: "ed25519"
#   identifier: "<unpadded-base64url-public-key>"
# admin_identity:
#   scheme: "ed25519"
#   identifier: "<distinct-unpadded-base64url-public-key>"

# Golden image credentials for local testing:
# golden_root_ssh_filename: "id_ed25519"
# golden_root_ssh_password: "yourpassword"
