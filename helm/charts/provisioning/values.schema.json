{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["server", "sshKey", "sshDecryptionKey", "identity", "storefrontIdentity", "adminIdentity"],
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "image": {"$ref": "#/definitions/image"}
      }
    },
    "identity": {"$ref": "#/definitions/identity"},
    "storefrontIdentity": {"$ref": "#/definitions/trustedIdentitySet"},
    "adminIdentity": {"$ref": "#/definitions/trustedIdentitySet"},
    "sshKey": {"$ref": "#/definitions/secretReference"},
    "config": {
      "type": "object",
      "properties": {
        "golden_root_ssh_password": false,
        "frp_dashboard_password": false,
        "ssh_decryption_key": false,
        "inventory_ini": false,
        "storefront_admin_key": false
      }
    },
    "sshDecryptionKey": {"$ref": "#/definitions/secretReference"},
    "inventory": false,
    "storefront": {
      "type": "object",
      "properties": {
        "adminKey": false
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "anyOf": [
            {"const": ""},
            {"pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "credentialSecret"],
      "properties": {
        "principal": {"$ref": "#/definitions/publicIdentity"},
        "credentialSecret": {"$ref": "#/definitions/credentialSecret"}
      }
    },
    "publicIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "identifier"],
      "properties": {
        "scheme": {"enum": ["ed25519", "eip191"]},
        "identifier": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"scheme": {"const": "eip191"}}},
          "then": {"properties": {"identifier": {"pattern": "^0x[0-9a-f]{40}$"}}}
        },
        {
          "if": {"properties": {"scheme": {"const": "ed25519"}}},
          "then": {"properties": {"identifier": {"pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"}}}
        }
      ]
    },
    "trustedIdentitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principals"],
      "properties": {
        "principals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/publicIdentity"}
        }
      }
    },
    "credentialSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createSecret", "secretName"],
      "properties": {
        "createSecret": {"const": false},
        "secretName": {"type": "string", "minLength": 1},
        "sshPrivateKey": false,
        "privateKey": false,
        "key": false
      }
    }
  }
}
