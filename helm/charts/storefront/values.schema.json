{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "publicIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "identifier"],
      "properties": {
        "scheme": {"enum": ["ed25519", "eip191"]},
        "identifier": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"scheme": {"const": "eip191"}}},
          "then": {"properties": {"identifier": {"pattern": "^0x[0-9a-f]{40}$"}}}
        },
        {
          "if": {"properties": {"scheme": {"const": "ed25519"}}},
          "then": {"properties": {"identifier": {"pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"}}}
        }
      ]
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/publicIdentity"}
    },
    "trustedIdentitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principals"],
      "properties": {
        "principals": {"$ref": "#/definitions/principals"}
      }
    }
  },
  "type": "object",
  "required": ["agents"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "anyOf": [
            {"const": ""},
            {"pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "identity"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["principal", "credentialSecret"],
            "properties": {
              "principal": {"$ref": "#/definitions/publicIdentity"},
              "credentialSecret": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "key"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "key": {"type": "string", "minLength": 1}
                }
              },
              "servicePeers": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["role", "siteId", "principals"],
                  "properties": {
                    "role": {"const": "service"},
                    "siteId": {"type": "string", "minLength": 1},
                    "principals": {"$ref": "#/definitions/principals"}
                  }
                }
              },
              "administrators": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["principals"],
                  "properties": {
                    "principals": {"$ref": "#/definitions/principals"}
                  }
                }
              }
            }
          },
          "secret": {
            "type": "object",
            "properties": {
              "createSecret": {"const": false},
              "secretName": {"type": "string"},
              "configKey": {"type": "string", "minLength": 1},
              "privKey": false,
              "privateKey": false,
              "hostedSettlementRequestCredential": false
            }
          },
          "config": {
            "type": "object",
            "required": ["registryAuthority"],
            "properties": {
              "chain": {
                "type": "object",
                "required": ["name"],
                "properties": {"name": {"type": "string", "minLength": 1}}
              },
              "registryAuthority": {
                "type": "object",
                "additionalProperties": false,
                "required": ["authority", "principals"],
                "properties": {
                  "authority": {"type": "string", "minLength": 1},
                  "principals": {"$ref": "#/definitions/principals"}
                }
              },
              "hostedSettlement": {
                "type": "object",
                "properties": {
                  "enabled": {"type": "boolean"},
                  "expectedAuthority": {"$ref": "#/definitions/trustedIdentitySet"},
                  "contractVersion": {"const": "0.1.0"},
                  "expectedSchemaVersion": {"const": 4},
                  "expectedManifestDigest": {"pattern": "^(sha256:)?[0-9a-f]{64}$"},
                  "requiredCapabilities": {
                    "type": "array",
                    "allOf": [
                      {"contains": {"const": "scheme-tagged-identities.v1"}},
                      {"contains": {"const": "account-owner-admission.v1"}},
                      { "contains": { "const": "account-owner-retirement.v1" } },
                      {"contains": {"const": "account-owner-rotation.v1"}},
                      {"contains": {"const": "signer-injected-client.v1"}},
                      {"contains": {"const": "provider-neutral-seller-onboarding.v1"}}
                    ]
                  }
                },
                "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
                "then": {
                  "required": ["contractVersion", "expectedSchemaVersion", "expectedManifestDigest", "expectedAuthority", "requiredCapabilities"]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["config"],
              "properties": {
                "config": {"required": ["chain"]}
              }
            },
            "then": {
              "required": ["secret"],
              "properties": {
                "secret": {
                  "required": ["createSecret", "secretName"],
                  "properties": {
                    "createSecret": {"const": false},
                    "secretName": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
