{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "publicIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "identifier"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "ed25519",
            "eip191"
          ]
        },
        "identifier": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "eip191"
              }
            }
          },
          "then": {
            "properties": {
              "identifier": {
                "pattern": "^0x[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "ed25519"
              }
            }
          },
          "then": {
            "properties": {
              "identifier": {
                "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
              }
            }
          }
        }
      ]
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/publicIdentity"
      }
    },
    "trustedIdentitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principals"
      ],
      "properties": {
        "principals": {
          "$ref": "#/definitions/principals"
        }
      }
    },
    "alkahestSettlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "address_config_path": {
          "type": "string",
          "minLength": 1
        },
        "oracle_gated": {
          "type": "boolean"
        },
        "trusted_oracle_addresses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]{40}$"
          }
        },
        "interruptible": {
          "type": "boolean"
        },
        "interruptible_oracle_addresses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]{40}$"
          }
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "priority"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "priority": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "alkahest.v1"
            ]
          }
        },
        "alkahest": {
          "$ref": "#/definitions/alkahestSettlement"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "priority": {
                "contains": {
                  "const": "alkahest.v1"
                }
              }
            }
          },
          "then": {
            "required": [
              "alkahest"
            ],
            "properties": {
              "alkahest": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            }
          }
        }
      ]
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settlements"
      ],
      "properties": {
        "default_min_price": {
          "type": [
            "string",
            "number"
          ]
        },
        "default_token_address": {
          "type": "string"
        },
        "default_max_duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "settlements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mechanism",
                  "asset",
                  "rate",
                  "per",
                  "mechanism_input"
                ],
                "properties": {
                  "mechanism": {
                    "const": "alkahest.v1"
                  },
                  "asset": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rate": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
                      }
                    ]
                  },
                  "per": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mechanism_input": {
                    "type": "object"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "wallet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{40}$"
        },
        "ssh_public_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "storefrontDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contribution",
          "offeringMode",
          "domainIdentity",
          "contractVersion"
        ],
        "properties": {
          "contribution": {
            "type": "string",
            "minLength": 1
          },
          "offeringMode": {
            "type": "string",
            "minLength": 1
          },
          "domainIdentity": {
            "type": "string",
            "minLength": 1
          },
          "contractVersion": {
            "type": "string",
            "pattern": "^[1-9][0-9]*\\.[0-9]+$"
          }
        }
      }
    },
    "chains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rpc_url",
          "chain_id"
        ],
        "properties": {
          "rpc_url": {
            "type": "string",
            "minLength": 1
          },
          "chain_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "agents"
  ],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "settlementConfigSchemaVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "identity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principal",
              "credentialSecret"
            ],
            "properties": {
              "principal": {
                "$ref": "#/definitions/publicIdentity"
              },
              "credentialSecret": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "servicePeers": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "role",
                    "siteId",
                    "principals"
                  ],
                  "properties": {
                    "role": {
                      "const": "service"
                    },
                    "siteId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "principals": {
                      "$ref": "#/definitions/principals"
                    }
                  }
                }
              },
              "administrators": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "principals"
                  ],
                  "properties": {
                    "principals": {
                      "$ref": "#/definitions/principals"
                    }
                  }
                }
              }
            }
          },
          "secret": {
            "type": "object",
            "properties": {
              "createSecret": {
                "const": false
              },
              "secretName": {
                "type": "string"
              },
              "configKey": {
                "type": "string",
                "minLength": 1
              },
              "privKey": false,
              "privateKey": false,
              "walletPrivateKey": false
            }
          },
          "config": {
            "type": "object",
            "required": [
              "registryAuthority",
              "storefrontDomains"
            ],
            "properties": {
              "hostedSettlement": false,
              "chain": false,
              "settlement": {
                "$ref": "#/definitions/settlement"
              },
              "pricing": {
                "$ref": "#/definitions/pricing"
              },
              "wallet": {
                "$ref": "#/definitions/wallet"
              },
              "chains": {
                "$ref": "#/definitions/chains"
              },
              "storefrontDomains": {
                "$ref": "#/definitions/storefrontDomains"
              },
              "registryAuthority": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "authority",
                  "principals"
                ],
                "properties": {
                  "authority": {
                    "type": "string",
                    "minLength": 1
                  },
                  "principals": {
                    "$ref": "#/definitions/principals"
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "config": {
                  "properties": {
                    "settlement": {
                      "properties": {
                        "alkahest": {
                          "properties": {
                            "enabled": {
                              "const": true
                            }
                          },
                          "required": [
                            "enabled"
                          ]
                        }
                      },
                      "required": [
                        "alkahest"
                      ]
                    }
                  },
                  "required": [
                    "settlement"
                  ]
                }
              },
              "required": [
                "config"
              ]
            },
            "then": {
              "required": [
                "secret"
              ],
              "properties": {
                "secret": {
                  "required": [
                    "createSecret",
                    "secretName"
                  ],
                  "properties": {
                    "createSecret": {
                      "const": false
                    },
                    "secretName": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "config": {
                  "required": [
                    "wallet",
                    "chains"
                  ],
                  "properties": {
                    "wallet": {
                      "required": [
                        "address"
                      ]
                    },
                    "chains": {
                      "minProperties": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
