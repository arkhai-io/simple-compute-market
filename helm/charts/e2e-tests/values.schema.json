{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["createSecret", "secretName"],
  "properties": {
    "integrationTests": {
      "type": "object",
      "properties": {
        "digest": {
          "anyOf": [
            {"const": ""},
            {"pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        }
      }
    },
    "createSecret": {"const": false},
    "secretName": {"type": "string", "minLength": 1},
    "seller": {"$ref": "#/definitions/publicPrincipal"},
    "buyer": {"$ref": "#/definitions/publicPrincipal"}
  },
  "definitions": {
    "publicPrincipal": {
      "type": "object",
      "properties": {
        "privateKey": false,
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "identifier"],
          "properties": {
            "scheme": {"enum": ["ed25519", "eip191"]},
            "identifier": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
