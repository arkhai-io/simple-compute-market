{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["createSecret", "secretName"],
  "properties": {
    "integrationTests": {
      "type": "object",
      "properties": {
        "digest": {
          "anyOf": [
            {"const": ""},
            {"pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        }
      }
    },
    "createSecret": {"const": false},
    "secretName": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "markers": {"type": "string"}
      }
    },
    "config": {
      "description": "End-to-end settings passed through whole as the e2e-tests profile, a ConfigMap: a key ending in credential, private_key, _key, token or secret (lowercase or uppercase) is refused at any depth; a setting needing a credential names the e2e-secret key holding it.",
      "$ref": "#/definitions/publicSettings"
    },
    "seller": {"$ref": "#/definitions/publicPrincipal"},
    "buyer": {"$ref": "#/definitions/buyerRuntime"},
    "payments": {
      "description": "Public PAYMENTS settings for the helm test profile; credentials are refused.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_url": {"type": "string", "pattern": "^https://\\S+$"},
        "service_identity": {"type": "string", "minLength": 1},
        "fee_bps": {"type": "integer", "minimum": 0},
        "livemode": {"type": "boolean"},
        "lane_owned": {"type": "boolean"},
        "api_key_env": {"type": "string", "minLength": 1},
        "buyer_account": {"type": "string", "minLength": 1},
        "seller_account": {"type": "string", "minLength": 1}
      }
    }
  },
  "definitions": {
    "publicSettings": {
      "type": "object",
      "propertyNames": {
        "not": {"pattern": "(credential|CREDENTIAL|private_key|PRIVATE_KEY|_key|_KEY|token|TOKEN|secret|SECRET)$"}
      },
      "additionalProperties": {"$ref": "#/definitions/publicValue"}
    },
    "publicValue": {
      "anyOf": [
        {"$ref": "#/definitions/publicSettings"},
        {"type": "array", "items": {"$ref": "#/definitions/publicValue"}},
        {"not": {"type": ["object", "array"]}}
      ]
    },
    "buyerRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "profileStore", "credentialSecret"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "identifier"],
          "properties": {
            "scheme": {"enum": ["ed25519", "eip191"]},
            "identifier": {"type": "string", "minLength": 1}
          }
        },
        "profileStore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingClaim", "mountPath"],
          "properties": {
            "existingClaim": {"type": "string", "minLength": 1},
            "mountPath": {"type": "string", "pattern": "^/"}
          }
        },
        "credentialSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key", "mountPath"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1},
            "mountPath": {"type": "string", "pattern": "^/"}
          }
        }
      }
    },
    "publicPrincipal": {
      "type": "object",
      "properties": {
        "privateKey": false,
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "identifier"],
          "properties": {
            "scheme": {"enum": ["ed25519", "eip191"]},
            "identifier": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
