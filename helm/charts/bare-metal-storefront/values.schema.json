{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "replicaCount",
    "service",
    "identity",
    "adminPrincipals",
    "sitePlacement",
    "publicUrl",
    "sellerEvmAddress",
    "alkahestEnabled",
    "settlementConfigSecret",
    "databasePath",
    "persistence"
  ],
  "properties": {
    "enabled": {"type": "boolean"},
    "global": {
      "type": "object",
      "properties": {"imageRepository": {"type": "string"}},
      "additionalProperties": true
    },
    "image": {"$ref": "#/definitions/image"},
    "replicaCount": {"const": 1},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "credentialSecret"],
      "properties": {
        "principal": {"$ref": "#/definitions/publicIdentity"},
        "credentialSecret": {"$ref": "#/definitions/secretReference"}
      }
    },
    "adminPrincipals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/publicIdentity"}
    },
    "siteBindingsSecret": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/secretReference"}]},
    "sitePlacement": {"enum": ["fill_first", "round_robin"]},
    "publicUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "sellerEvmAddress": {
      "type": "string",
      "pattern": "^(|0x[0-9a-fA-F]{40})$"
    },
    "alkahestEnabled": {"type": "boolean"},
    "settlementConfigSecret": {"$ref": "#/definitions/secretReference"},
    "deliveryConfigSecret": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/resourceDataReference"}]},
    "databasePath": {"type": "string", "minLength": 1, "pattern": "^/"},
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingClaim", "storageClass", "size", "accessMode", "mountPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "size": {"type": "string", "minLength": 1},
        "accessMode": {"const": "ReadWriteOnce"},
        "mountPath": {"type": "string", "minLength": 1, "pattern": "^/"}
      }
    },
    "contactOffers": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configMap",
            "registry"
          ],
          "properties": {
            "configMap": {
              "$ref": "#/definitions/secretReference"
            },
            "registry": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "authority",
                "principals",
                "apiKeySecret"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "authority": {
                  "type": "string",
                  "minLength": 1
                },
                "principals": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/publicIdentity"
                  }
                },
                "apiKeySecret": {
                  "$ref": "#/definitions/secretReference"
                }
              }
            }
          }
        }
      ]
    },
    "contactDeclarations": {
      "allOf": [
        {"$ref": "#/properties/contactOffers"},
        {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "properties": {
                "configMap": {
                  "allOf": [
                    {"$ref": "#/definitions/resourceDataReference"},
                    {"$ref": "#/definitions/projectableDataKey"}
                  ]
                },
                "registry": {
                  "type": "object",
                  "properties": {
                    "apiKeySecret": {
                      "allOf": [
                        {"$ref": "#/definitions/resourceDataReference"},
                        {"$ref": "#/definitions/projectableDataKey"}
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "resources": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  },
  "allOf": [
    {
      "not": {
        "required": ["contactOffers", "contactDeclarations"],
        "properties": {
          "contactOffers": {"type": "object"},
          "contactDeclarations": {"type": "object"}
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {"required": ["contactOffers"], "properties": {"contactOffers": {"type": "object"}}},
          {"required": ["contactDeclarations"], "properties": {"contactDeclarations": {"type": "object"}}}
        ]
      },
      "then": {
        "properties": {
          "alkahestEnabled": {
            "const": false
          },
          "persistence": {
            "anyOf": [
              {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "existingClaim": {
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "name", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {
          "anyOf": [
            {"const": ""},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "resourceDataReference": {
      "type": "object", "additionalProperties": false, "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"},
        "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    },
    "projectableDataKey": {
      "description": "Overlay for a data key the pod projects as a file: Kubernetes rejects '.' and any key starting with '..', so such a key can never name a readable entry.",
      "properties": {
        "key": {
          "allOf": [
            {"not": {"const": "."}},
            {"not": {"pattern": "^\\.\\."}}
          ]
        }
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "publicIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "identifier"],
          "properties": {
            "scheme": {"const": "eip191"},
            "identifier": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "identifier"],
          "properties": {
            "scheme": {"const": "ed25519"},
            "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
          }
        }
      ]
    }
  }
}
