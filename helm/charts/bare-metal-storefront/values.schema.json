{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "replicaCount",
    "port",
    "service",
    "identity",
    "secret",
    "alkahestAddressBook",
    "config",
    "persistence"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object",
      "properties": {
        "imageRepository": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "replicaCount": {
      "const": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialSecret"
      ],
      "properties": {
        "credentialSecret": {
          "$ref": "#/definitions/secretReference"
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName",
        "configKey"
      ],
      "properties": {
        "secretName": {
          "type": "string"
        },
        "configKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "alkahestAddressBook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configMapName",
        "key",
        "mountPath"
      ],
      "properties": {
        "configMapName": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        }
      }
    },
    "internalRegistryTrust": {
      "anyOf": [
        {
          "$ref": "#/definitions/registryAuthority"
        },
        {
          "type": "null"
        }
      ]
    },
    "config": {
      "anyOf": [
        {
          "$ref": "#/definitions/storefrontServiceConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingClaim",
        "storageClass",
        "size",
        "accessMode",
        "mountPath"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "retainOnUninstall": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "accessMode": {
          "const": "ReadWriteOnce"
        },
        "mountPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "name",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publicIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "identifier"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "ed25519",
            "eip191"
          ]
        },
        "identifier": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "eip191"
              }
            }
          },
          "then": {
            "properties": {
              "identifier": {
                "pattern": "^0x[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "ed25519"
              }
            }
          },
          "then": {
            "properties": {
              "identifier": {
                "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
              }
            }
          }
        }
      ]
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/publicIdentity"
      }
    },
    "registryAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "principals"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "principals": {
          "$ref": "#/definitions/principals"
        }
      }
    },
