{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "integrationTests": {
          "$ref": "#/definitions/image"
        },
        "registryIdentity": {
          "$ref": "#/definitions/activeRegistryIdentity"
        },
        "provisioningIdentity": {
          "$ref": "#/definitions/publicIdentity"
        },
        "rpc": {
          "type": "object",
          "required": [
            "enabled",
            "chainId",
            "host",
            "port"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "chainId": {
              "type": "integer",
              "minimum": 1
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "registry": {
      "$ref": "#/definitions/registryInstance"
    },
    "api-credits-registry": {
      "$ref": "#/definitions/registryInstance"
    },
    "storefront": {
      "type": "object",
      "properties": {
        "image": {
          "allOf": [
            {
              "$ref": "#/definitions/image"
            },
            {
              "properties": {
                "settlementConfigSchemaVersion": false
              }
            }
          ]
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/storefrontAgent"
          }
        }
      }
    },
    "bare-metal-storefront": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "provisioning": {
      "type": "object",
      "required": [
        "identity",
        "storefrontIdentity",
        "adminIdentity"
      ],
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/definitions/image"
            }
          }
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "storefrontIdentity": {
          "$ref": "#/definitions/bootstrapIdentity"
        },
        "adminIdentity": {
          "$ref": "#/definitions/bootstrapIdentity"
        },
        "sshKey": {
          "$ref": "#/definitions/externalSecretReference"
        },
        "sshDecryptionKey": {
          "$ref": "#/definitions/externalSecretReference"
        },
        "config": {
          "type": "object",
          "properties": {
            "golden_root_ssh_password": false,
            "relay_token": false,
            "ssh_decryption_key": false,
            "inventory_ini": false,
            "storefront_admin_key": false
          }
        },
        "storefront": {
          "type": "object",
          "properties": {
            "adminKey": false
          }
        },
        "inventory": false
      }
    },
    "integrationTests": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "e2e-tests": {
      "type": "object",
      "properties": {
        "integrationTests": {
          "$ref": "#/definitions/image"
        },
        "createSecret": {
          "const": false
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "seller": {
          "$ref": "#/definitions/publicEip191Principal"
        },
        "buyer": {
          "$ref": "#/definitions/publicEip191Principal"
        }
      }
    }
  },
  "definitions": {
    "registryInstance": {
      "type": "object",
      "required": [
        "identity",
        "descriptor"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "descriptor": {
          "$ref": "#/definitions/registryDescriptor"
        },
        "config": {
          "type": "object",
          "properties": {
            "filterSpecPath": {
              "type": "string",
              "pattern": "^/\\S+\\.ya?ml$"
            },
            "rootPath": {
              "type": "string"
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "externalSecretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createSecret",
        "secretName"
      ],
      "properties": {
        "createSecret": {
          "const": false
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "sshPrivateKey": false,
        "privateKey": false,
        "key": false
      }
    },
    "credentialSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "credentialSecret"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "$ref": "#/definitions/publicIdentity"
        },
        "credentialSecret": {
          "$ref": "#/definitions/credentialSecret"
        },
        "servicePeers": {
          "$ref": "#/definitions/servicePeers"
        },
        "administrators": {
          "$ref": "#/definitions/administrators"
        }
      }
    },
    "publicIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "identifier"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "ed25519",
            "eip191"
          ]
        },
        "identifier": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "eip191"
              }
            }
          },
          "then": {
            "properties": {
              "identifier": {
                "pattern": "^0x[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "ed25519"
              }
            }
          },
          "then": {
            "properties": {
              "identifier": {
                "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
              }
            }
          }
        }
      ]
    },
    "bootstrapIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principals"
      ],
      "properties": {
        "principals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/publicIdentity"
          }
        }
      }
    },
    "activeRegistryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "principal"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "$ref": "#/definitions/publicIdentity"
        }
      }
    },
    "registryDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "displayName",
        "operatorIdentity"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operatorIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accessAcquisitionPointer": {
          "type": "string",
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^https?://\\S+$"
            }
          ]
        }
      }
    },
    "registryAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "principals"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "principals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/publicIdentity"
          }
        }
      }
    },
    "servicePeers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "siteId",
          "principals"
        ],
        "properties": {
          "role": {
            "const": "service"
          },
          "siteId": {
            "type": "string",
            "minLength": 1
          },
          "principals": {
            "$ref": "#/definitions/trustedIdentitySet/properties/principals"
          }
        }
      }
    },
    "administrators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principals"
        ],
        "properties": {
          "principals": {
            "$ref": "#/definitions/trustedIdentitySet/properties/principals"
          }
        }
      }
    },
    "storefrontAgent": {
      "type": "object",
      "required": [
        "name",
        "identity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "configMapName": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/definitions/storefrontIdentity"
        },
        "internalRegistryTrust": {
          "$ref": "#/definitions/registryAuthority"
        },
        "secret": {
          "type": "object",
          "properties": {
            "createSecret": {
              "const": false
            },
            "secretName": {
              "type": "string"
            },
            "configKey": {
              "type": "string",
              "minLength": 1
            },
            "privKey": false,
            "privateKey": false,
            "walletPrivateKey": false
          }
        },
        "agentId": false,
        "autoRegister": false,
        "rootPath": false,
        "config": {
          "allOf": [
            {
              "$ref": "#/definitions/storefrontServiceConfig"
            },
            {
              "type": "object",
              "properties": {
                "seller": false,
                "registryAuthority": false,
                "registryUrl": false,
                "storefrontDomains": false,
                "configMapName": false,
                "hostedSettlement": false,
                "chain": false
              }
            }
          ]
        }
      }
    },
    "publicEip191Principal": {
      "type": "object",
      "properties": {
        "privateKey": false,
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "identifier"
          ],
          "properties": {
            "scheme": {
              "const": "eip191"
            },
            "identifier": {
              "pattern": "^0x[0-9a-f]{40}$"
            }
          }
        }
      }
    },
    "storefrontIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialSecret"
      ],
      "properties": {
        "credentialSecret": {
          "$ref": "#/definitions/credentialSecret"
        }
      }
    },
    "storefrontServiceConfig": {
      "type": "object",
      "patternProperties": {
        "^[iI][dD][eE][nN][tT][iI][tT][yY]$": {
          "additionalProperties": false,
          "properties": {
            "principal": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "scheme": {
                      "enum": [
                        "eip191",
                        "ed25519"
                      ],
                      "type": "string"
                    },
                    "identifier": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "scheme",
                    "identifier"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "administrators": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "principals": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "scheme": {
                          "enum": [
                            "eip191",
                            "ed25519"
                          ],
                          "type": "string"
                        },
                        "identifier": {
                          "maxLength": 128,
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "scheme",
                        "identifier"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "type": "object"
            },
            "service_peers": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "site_id": {
                    "type": "string"
                  },
                  "principals": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "scheme": {
                          "enum": [
                            "eip191",
                            "ed25519"
                          ],
                          "type": "string"
                        },
                        "identifier": {
                          "maxLength": 128,
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "scheme",
                        "identifier"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "^[rR][eE][gG][iI][sS][tT][rR][yY]$": {
          "additionalProperties": true,
          "properties": {},
          "type": "object",
          "patternProperties": {
            "^[aA][uU][tT][hH]$": false
          }
        },
        "^[sS][eE][tT][tT][lL][eE][mM][eE][nN][tT]$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "type": "integer"
            },
            "priority": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "alkahest": {
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "address_config_path": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "oracle_gated": {
                  "type": "boolean"
                },
                "trusted_oracle_addresses": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "interruptible": {
                  "type": "boolean"
                },
                "interruptible_oracle_addresses": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "stripe": {
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "base_url": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "authority_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "environment": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "authority": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "principals": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "scheme": {
                                "enum": [
                                  "eip191",
                                  "ed25519"
                                ],
                                "type": "string"
                              },
                              "identifier": {
                                "maxLength": 128,
                                "minLength": 1,
                                "type": "string"
                              }
                            },
                            "required": [
                              "scheme",
                              "identifier"
                            ],
                            "type": "object"
                          },
                          "maxItems": 2,
                          "minItems": 1,
                          "type": "array"
                        }
                      },
                      "required": [
                        "principals"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expected_manifest_digest": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expected_api_version": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expected_schema_version": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "required_capabilities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "account_ref": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "const": "usd",
                  "type": "string"
                },
                "country": {
                  "const": "US",
                  "type": "string"
                },
                "condition_profile": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "condition_profiles": {
                  "additionalProperties": {
                    "additionalProperties": false,
                    "properties": {
                      "protocol": {
                        "const": "arkhai.condition.v1",
                        "type": "string"
                      },
                      "condition_id": {
                        "maxLength": 128,
                        "minLength": 1,
                        "type": "string"
                      },
                      "evaluator": {
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": [
                              "alkahest.evm-arbiter.v1",
                              "external-http.v1",
                              "builtin.v1"
                            ],
                            "type": "string"
                          },
                          "version": {
                            "maxLength": 64,
                            "minLength": 1,
                            "type": "string"
                          },
                          "resolver_id": {
                            "anyOf": [
                              {
                                "maxLength": 128,
                                "minLength": 1,
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "arbiter_id": {
                            "anyOf": [
                              {
                                "maxLength": 128,
                                "minLength": 1,
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "params": {
                            "additionalProperties": {
                              "anyOf": [
                                {
                                  "type": "boolean"
                                },
                                {
                                  "type": "integer"
                                },
                                {
                                  "type": "string"
                                },
                                {
                                  "items": {},
                                  "type": "array"
                                },
                                {
                                  "additionalProperties": {},
                                  "type": "object"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "type": "object"
                          }
                        },
                        "required": [
                          "kind",
                          "version"
                        ],
                        "type": "object"
                      },
                      "demand": {
                        "additionalProperties": false,
                        "properties": {
                          "encoding": {
                            "enum": [
                              "evm-abi",
                              "application/jcs+json"
                            ],
                            "type": "string"
                          },
                          "value": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "anyOf": [
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "type": "integer"
                                  },
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "items": {},
                                    "type": "array"
                                  },
                                  {
                                    "additionalProperties": {},
                                    "type": "object"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        "required": [
                          "encoding",
                          "value"
                        ],
                        "type": "object"
                      },
                      "evm_subject": {
                        "anyOf": [
                          {
                            "additionalProperties": false,
                            "properties": {
                              "address": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "address"
                            ],
                            "type": "object"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "condition_id",
                      "evaluator",
                      "demand"
                    ],
                    "type": "object"
                  },
                  "type": "object"
                },
                "resolvers": {
                  "additionalProperties": {
                    "additionalProperties": false,
                    "properties": {
                      "chain_name": {
                        "maxLength": 128,
                        "minLength": 1,
                        "type": "string"
                      },
                      "evidence_mode": {
                        "enum": [
                          "eas.v1",
                          "portable-remote.v1"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "chain_name",
                      "evidence_mode"
                    ],
                    "type": "object"
                  },
                  "type": "object"
                },
                "request_timeout_seconds": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "preflight_timeout_seconds": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "allow_insecure_loopback": {
                  "type": "boolean"
                }
              },
              "type": "object",
              "patternProperties": {
                "^[oO][fF][fF]_[sS][eE][sS][sS][iI][oO][nN]_[pP][oO][lL][iI][cC][yY]$": false,
                "^[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]_[jJ][oO][uU][rR][nN][aA][lL]_[pP][aA][tT][hH]$": false
              }
            }
          }
        },
        "^[wW][aA][lL][lL][eE][tT]$": {
          "additionalProperties": false,
          "properties": {
            "address": {
              "type": "string"
            },
            "ssh_public_key": {
              "type": "string"
            }
          },
          "type": "object",
          "patternProperties": {
            "^[pP][rR][iI][vV][aA][tT][eE]_[kK][eE][yY]$": false
          }
        }
      }
