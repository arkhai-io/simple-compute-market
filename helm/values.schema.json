{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "integrationTests": {
          "$ref": "#/definitions/image"
        },
        "registryIdentity": {
          "$ref": "#/definitions/activeRegistryIdentity"
        },
        "provisioningIdentity": {
          "$ref": "#/definitions/publicIdentity"
        },
        "rpc": {
          "type": "object",
          "required": [
            "enabled",
            "chainId",
            "host",
            "port"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "chainId": {
              "type": "integer",
              "minimum": 1
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "registry": {
      "$ref": "#/definitions/registryInstance"
    },
    "api-credits-registry": {
      "$ref": "#/definitions/registryInstance"
    },
    "storefront": {
      "type": "object",
      "properties": {
        "image": {
          "allOf": [
            {
              "$ref": "#/definitions/image"
            },
            {
              "properties": {
                "settlementConfigSchemaVersion": false
              }
            }
          ]
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/storefrontAgent"
          }
        }
      }
    },
    "bare-metal-storefront": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "provisioning": {
      "type": "object",
      "required": [
        "identity",
        "storefrontIdentity",
        "adminIdentity"
      ],
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/definitions/image"
            }
          }
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "storefrontIdentity": {
          "$ref": "#/definitions/bootstrapIdentity"
        },
        "adminIdentity": {
          "$ref": "#/definitions/bootstrapIdentity"
        },
        "sshKey": {
          "$ref": "#/definitions/externalSecretReference"
        },
        "sshDecryptionKey": {
          "$ref": "#/definitions/externalSecretReference"
        },
        "config": {
          "type": "object",
          "properties": {
            "golden_root_ssh_password": false,
            "relay_token": false,
            "ssh_decryption_key": false,
            "inventory_ini": false,
            "storefront_admin_key": false
          }
        },
        "storefront": {
          "type": "object",
          "properties": {
            "adminKey": false
          }
        },
        "inventory": false
      }
    },
    "integrationTests": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "e2e-tests": {
      "type": "object",
      "properties": {
        "integrationTests": {
          "$ref": "#/definitions/image"
        },
        "createSecret": {
          "const": false
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "seller": {
          "$ref": "#/definitions/publicEip191Principal"
        },
        "buyer": {
          "$ref": "#/definitions/publicEip191Principal"
        }
      }
    }
  },
  "definitions": {
    "registryInstance": {
      "type": "object",
      "required": [
        "identity",
        "descriptor"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "descriptor": {
          "$ref": "#/definitions/registryDescriptor"
        },
        "config": {
          "type": "object",
          "properties": {
            "filterSpecPath": {
              "type": "string",
              "pattern": "^/\\S+\\.ya?ml$"
            },
            "rootPath": {
              "type": "string"
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "externalSecretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createSecret",
        "secretName"
      ],
      "properties": {
        "createSecret": {
          "const": false
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "sshPrivateKey": false,
        "privateKey": false,
        "key": false
      }
    },
    "credentialSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "credentialSecret"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "$ref": "#/definitions/publicIdentity"
        },
        "credentialSecret": {
          "$ref": "#/definitions/credentialSecret"
        },
        "servicePeers": {
          "$ref": "#/definitions/servicePeers"
        },
        "administrators": {
          "$ref": "#/definitions/administrators"
        }
      }
    },
    "publicIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "identifier"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "ed25519",
            "eip191"
          ]
        },
        "identifier": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "eip191"
              }
            }
          },
          "then": {
            "properties": {
              "identifier": {
                "pattern": "^0x[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "ed25519"
              }
            }
          },
          "then": {
            "properties": {
              "identifier": {
                "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
              }
            }
          }
        }
      ]
    },
    "bootstrapIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principals"
      ],
      "properties": {
        "principals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/publicIdentity"
          }
        }
      }
    },
    "activeRegistryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "principal"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "$ref": "#/definitions/publicIdentity"
        }
      }
    },
    "registryDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "displayName",
        "operatorIdentity"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operatorIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accessAcquisitionPointer": {
          "type": "string",
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^https?://\\S+$"
            }
          ]
        }
      }
    },
    "registryAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "principals"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "principals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/publicIdentity"
          }
        }
      }
    },
    "servicePeers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "siteId",
          "principals"
        ],
        "properties": {
          "role": {
            "const": "service"
          },
          "siteId": {
            "type": "string",
            "minLength": 1
          },
          "principals": {
            "$ref": "#/definitions/trustedIdentitySet/properties/principals"
          }
        }
      }
    },
    "administrators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principals"
        ],
        "properties": {
          "principals": {
            "$ref": "#/definitions/trustedIdentitySet/properties/principals"
          }
        }
      }
    },
    "storefrontAgent": {
      "type": "object",
      "required": [
        "name",
        "identity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "configMapName": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/definitions/storefrontIdentity"
        },
        "internalRegistryTrust": {
          "$ref": "#/definitions/registryAuthority"
        },
        "secret": {
          "type": "object",
          "properties": {
            "createSecret": {
              "const": false
            },
            "secretName": {
              "type": "string"
            },
            "configKey": {
              "type": "string",
              "minLength": 1
            },
            "privKey": false,
            "privateKey": false,
            "walletPrivateKey": false
          }
        },
        "agentId": false,
        "autoRegister": false,
        "rootPath": false,
        "config": {
          "allOf": [
            {
              "$ref": "#/definitions/storefrontServiceConfig"
            },
            {
              "type": "object",
              "patternProperties": {
                "^[sS][eE][lL][lL][eE][rR]$": false,
                "^[rR][eE][gG][iI][sS][tT][rR][yY][aA][uU][tT][hH][oO][rR][iI][tT][yY]$": false,
                "^[rR][eE][gG][iI][sS][tT][rR][yY][uU][rR][lL]$": false,
                "^[sS][tT][oO][rR][eE][fF][rR][oO][nN][tT][dD][oO][mM][aA][iI][nN][sS]$": false,
                "^[cC][oO][nN][fF][iI][gG][mM][aA][pP][nN][aA][mM][eE]$": false,
                "^[hH][oO][sS][tT][eE][dD][sS][eE][tT][tT][lL][eE][mM][eE][nN][tT]$": false,
                "^[cC][hH][aA][iI][nN]$": false
              }
            }
          ]
        }
      }
    },
    "publicEip191Principal": {
      "type": "object",
      "properties": {
        "privateKey": false,
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "identifier"
          ],
          "properties": {
            "scheme": {
              "const": "eip191"
            },
            "identifier": {
              "pattern": "^0x[0-9a-f]{40}$"
            }
          }
        }
      }
    },
    "storefrontIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialSecret"
      ],
      "properties": {
        "credentialSecret": {
          "$ref": "#/definitions/credentialSecret"
        }
      }
    },
    "storefrontServiceConfig": {
      "type": "object",
      "patternProperties": {
        "^[dD][eE][lL][iI][vV][eE][rR][yY]$": {
          "type": "object",
          "patternProperties": {
            "^[eE][nN][aA][bB][lL][eE][dD]$": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
              "type": "number"
            },
            "^[oO][rR][iI][gG][iI][nN][sS]$": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "^[aA][pP][pP][rR][iI][sS][eE]$": {
              "additionalProperties": false,
              "type": "object",
              "patternProperties": {
                "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "^[uU][rR][lL][sS]$": false,
                "^[tT][iI][tT][lL][eE]$": {
                  "type": "string"
                },
                "^[sS][iI][nN][kK]$": {
                  "const": "apprise"
                }
              }
            },
            "^[cC][oO][mM][mM][aA][nN][dD]$": {
              "additionalProperties": false,
              "type": "object",
              "patternProperties": {
                "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "^[aA][rR][gG][vV]$": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "^[sS][eE][nN][dD]$": {
                  "type": "string"
                },
                "^[sS][iI][nN][kK]$": {
                  "const": "command"
                }
              }
            },
            "^[fF][iI][lL][eE]$": {
              "additionalProperties": false,
              "type": "object",
              "patternProperties": {
                "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "^[pP][aA][tT][hH]$": {
                  "type": "string"
                },
                "^[sS][iI][nN][kK]$": {
                  "const": "file"
                }
              }
            },
            "^[sS][mM][tT][pP]$": {
              "additionalProperties": false,
              "type": "object",
              "patternProperties": {
                "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "^[hH][oO][sS][tT]$": {
                  "minLength": 1,
                  "type": "string"
                },
                "^[pP][oO][rR][tT]$": {
                  "maximum": 65535,
                  "minimum": 1,
                  "type": "integer"
                },
                "^[sS][eE][nN][dD][eE][rR]$": {
                  "minLength": 1,
                  "type": "string"
                },
                "^[rR][eE][cC][iI][pP][iI][eE][nN][tT][sS]$": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "^[sS][tT][aA][rR][tT]_[tT][lL][sS]$": {
                  "type": "boolean"
                },
                "^[uU][sS][eE][rR][nN][aA][mM][eE]$": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "^[pP][aA][sS][sS][wW][oO][rR][dD]$": false,
                "^[sS][uU][bB][jJ][eE][cC][tT]_[pP][rR][eE][fF][iI][xX]$": {
                  "type": "string"
                },
                "^[sS][iI][nN][kK]$": {
                  "const": "smtp"
                }
              }
            },
            "^[wW][eE][bB][hH][oO][oO][kK]$": {
              "additionalProperties": false,
              "type": "object",
              "patternProperties": {
                "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "^[uU][rR][lL]$": false,
                "^[hH][eE][aA][dD][eE][rR][sS]$": false,
                "^[sS][eE][nN][dD]$": {
                  "type": "string"
                },
                "^[sS][iI][gG][nN]$": {
                  "type": "boolean"
                },
                "^[sS][iI][nN][kK]$": {
                  "const": "webhook"
                }
              }
            }
          },
          "additionalProperties": {
            "type": "object",
            "dependencies": {
              "sink": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "patternProperties": {
                      "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                        "anyOf": [
                          {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "^[uU][rR][lL][sS]$": false,
                      "^[tT][iI][tT][lL][eE]$": {
                        "type": "string"
                      },
                      "^[sS][iI][nN][kK]$": {
                        "const": "apprise"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "patternProperties": {
                      "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                        "anyOf": [
                          {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "^[aA][rR][gG][vV]$": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "^[sS][eE][nN][dD]$": {
                        "type": "string"
                      },
                      "^[sS][iI][nN][kK]$": {
                        "const": "command"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "patternProperties": {
                      "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                        "anyOf": [
                          {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "^[pP][aA][tT][hH]$": {
                        "type": "string"
                      },
                      "^[sS][iI][nN][kK]$": {
                        "const": "file"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "patternProperties": {
                      "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                        "anyOf": [
                          {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "^[hH][oO][sS][tT]$": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "^[pP][oO][rR][tT]$": {
                        "maximum": 65535,
                        "minimum": 1,
                        "type": "integer"
                      },
                      "^[sS][eE][nN][dD][eE][rR]$": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "^[rR][eE][cC][iI][pP][iI][eE][nN][tT][sS]$": {
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      },
                      "^[sS][tT][aA][rR][tT]_[tT][lL][sS]$": {
                        "type": "boolean"
                      },
                      "^[uU][sS][eE][rR][nN][aA][mM][eE]$": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "^[pP][aA][sS][sS][wW][oO][rR][dD]$": false,
                      "^[sS][uU][bB][jJ][eE][cC][tT]_[pP][rR][eE][fF][iI][xX]$": {
                        "type": "string"
                      },
                      "^[sS][iI][nN][kK]$": {
                        "const": "smtp"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "patternProperties": {
                      "^[tT][iI][mM][eE][oO][uU][tT]_[sS][eE][cC][oO][nN][dD][sS]$": {
                        "anyOf": [
                          {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "^[uU][rR][lL]$": false,
                      "^[hH][eE][aA][dD][eE][rR][sS]$": false,
                      "^[sS][eE][nN][dD]$": {
                        "type": "string"
                      },
                      "^[sS][iI][gG][nN]$": {
                        "type": "boolean"
                      },
                      "^[sS][iI][nN][kK]$": {
                        "const": "webhook"
                      }
                    }
                  },
                  {
                    "patternProperties": {
                      "^sink$": {
                        "not": {
                          "enum": [
                            "apprise",
