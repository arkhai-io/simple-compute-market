# Local state Git ignores, which no package or render may read: the chart's
# content digest must not change with it (scripts/release_bom.py refuses a
# package storing a file Git ignores).
# `helm dependency update` writes the lock, with a timestamp, and an archive of
# each subchart, which would store its files a second time beside the
# subchart's directory; the chart's Python tests leave their caches.
Chart.lock
charts/*.tgz
__pycache__/
*.pyc
.pytest_cache/
.port-forward.pids
