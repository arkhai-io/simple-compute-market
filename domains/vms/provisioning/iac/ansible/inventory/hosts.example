# =============================================================================
# Ansible inventory: infrastructure — example template
# =============================================================================
# Copy to `hosts` and fill in your real values:
#   cp ansible/inventory/hosts.example ansible/inventory/hosts
#
# This file lists infrastructure you manage with these playbooks: relay (FRP)
# proxies and remote provisioning workers. The hosts you sell are in
# `provisioning-hosts.ini` in the same directory (see
# provisioning-hosts.example). Run playbooks against the whole directory,
# `-i inventory/`, so they see both; the provisioning service is given only
# `provisioning-hosts.ini`, and never registers anything listed here.
#
# The VM-operations playbook also records each VM it creates here, under
# `[kvms]`, and removes it when the VM is undefined; that group is written for
# you. The real file is gitignored so operator-specific IPs, usernames, and
# per-host overrides don't get committed. For a single-box seller you can
# leave both groups below empty.
# =============================================================================

[frp_servers]
# proxy-prod ansible_host=<IP> ansible_user=<user> ansible_ssh_private_key_file=~/.ssh/id_ed25519

[provisioning_servers]
# provisioning-prod ansible_host=<IP> ansible_user=<user> ansible_ssh_private_key_file=~/.ssh/id_ed25519
