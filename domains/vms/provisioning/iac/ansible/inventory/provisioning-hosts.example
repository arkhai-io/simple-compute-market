# =============================================================================
# Ansible inventory: the hosts you sell — example template
# =============================================================================
# Copy to `provisioning-hosts.ini` and fill in your real values:
#   cp ansible/inventory/provisioning-hosts.example ansible/inventory/provisioning-hosts.ini
#
# This file is Ansible's own host list, and the input of the provisioning
# service's INI import route (`POST /api/v1/hosts/import`), which registers
# every host entry in it when it is submitted. The service does not read it at
# startup: it registers the hosts its host definitions document declares
# (`host_definitions_path`). List only execution hosts: infrastructure goes in
# `hosts` in the same directory. Section names mean nothing to the service;
# `[kvm_hosts]` is the group the VM host-setup and VM-operations playbooks
# target when run against this directory (`-i inventory/`).
#
# Each line's first token is the host's `host_id`, which a capacity
# declaration names to say which host it is delivered through. A line says how
# to reach a machine and nothing about its hardware: what it has, and sells, is
# the capacity declared for it, never the host entry itself. A host's
# Resource Pool is optional: `pool_id=<pool>` places it, an empty `pool_id=`
# unplaces it, and a line with no `pool_id` leaves an existing host's pool as it
# is and registers a new host in no pool.
# The real file is gitignored.
# =============================================================================

[kvm_hosts]
# host1 ansible_host=<IP> ansible_user=<user> ansible_ssh_private_key_file=~/.ssh/id_ed25519
#
# Optional per-host args:
#   ansible_port=<port>     — if SSH isn't on 22
#   public_host=<IP/DNS>    — address buyers should use if different from ansible_host
#   pool_id=<pool>          — the Resource Pool to place the host in; empty unplaces it
