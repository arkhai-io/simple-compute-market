[Unit]
Description=Bind audited passthrough devices to vfio-pci
Documentation=man:vfio-pci(4)
# Ordered after the vfio modules are loaded, because the bind fails without
# vfio-pci, and before libvirtd so devices are in place before any guest is
# defined. No Requires= or BindsTo=: a failed bind must leave the host running
# with libvirt available and one fewer passthrough device, rather than taking
# virtualization down with it.
#
# This unit is enabled only after a bind has been applied and verified with a
# live connection to the host, so a boot never replays a list that has not been
# observed to work here.
After=systemd-modules-load.service
Before=libvirtd.service
ConditionPathExists={{ vfio_bind_state_path }}

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ vfio_bind_script_path }}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
