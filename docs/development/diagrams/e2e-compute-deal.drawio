 value="The buyer opens the negotiation and the seller force-accepts it, ending the thread in a successful terminal state." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#4a4f6a;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46.0" y="207.0" width="789.5" height="17" as="geometry"/></mxCell><mxCell id="17" value="" style="endArrow=block;endFill=1;strokeColor=#2f3350;strokeWidth=1.6;html=1;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="231.0" as="sourcePoint"/><mxPoint x="380.0" y="257.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f3350;strokeWidth=1.4;dashed=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="257.0" width="700.0" height="53.0" as="geometry"/></mxCell><mxCell id="19" value="Escrow" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#1f2340;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46.0" y="265.0" width="56.6" height="18" as="geometry"/></mxCell><mxCell id="20" value="settlement" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#4a4f6a;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="633.8" y="266.0" width="80.2" height="17" as="geometry"/></mxCell><mxCell id="21" value="The buyer escrows real tokens on the dev chain against the agreed terms, where the storefront verifies them." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#4a4f6a;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46.0" y="286.0" width="748.6" height="17" as="geometry"/></mxCell><mxCell id="22" value="" style="endArrow=block;endFill=1;strokeColor=#2f3350;strokeWidth=1.6;html=1;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="310.0" as="sourcePoint"/><mxPoint x="380.0" y="336.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f3350;strokeWidth=1.4;dashed=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="336.0" width="700.0" height="53.0" as="geometry"/></mxCell><mxCell id="24" value="Settle" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#1f2340;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46.0" y="344.0" width="56.6" height="18" as="geometry"/></mxCell><mxCell id="25" value="settlement" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#4a4f6a;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="633.8" y="345.0" width="80.2" height="17" as="geometry"/></mxCell><mxCell id="26" value="The buyer settles the escrow, and a fulfillment is dispatched to the placed host, not yet converged." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#4a4f6a;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46.0" y="365.0" width="741.7" height="17" as="geometry"/></mxCell><mxCell id="27" value="" style="endArrow=block;endFill=1;strokeColor=#2f3350;strokeWidth=1.6;html=1;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="389.0" as="sourcePoint"/><mxPoint x="380.0" y="415.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f3350;strokeWidth=1.4;dashed=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="415.0" width="700.0" height="68.0" as="geometry"/></mxCell><mxCell id="29" value="Deliver" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#1f2340;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46.0" y="423.0" width="64.1" height="18" as="geometry"/></mxCell><mxCell id="30" value="delivery" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#4a4f6a;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="647.4" y="424.0" width="66.6" height="17" as="geometry"/></mxCell><mxCell id="31" value="Once the create job ends — a mock lane releases its gate, the real lane polls the job — the fulfillment is" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#4a4f6a;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46.0" y="444.0" width="734.9" height="17" as="geometry"/></mxCell><mxCell id="32" value="active; the settlement is ready with the delivery, the listing closes, the seller&#x27;s claim or evidence is on chain." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#4a4f6a;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46.0" y="459.0" width="509.9" height="17" as="geometry"/></mxCell><mxCell id="33" value="" style="endArrow=block;endFill=1;strokeColor=#2f3350;strokeWidth=1.6;html=1;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="483.0" as="sourcePoint"/><mxPoint x="380.0" y="509.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f3350;strokeWidth=1.4;dashed=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="509.0" width="700.0" height="68.0" as="geometry"/></mxCell><mxCell id="35" value="Release" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#1f2340;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46.0" y="517.0" width="64.1" height="18" as="geometry"/></mxCell><mxCell id="36" value="teardown" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#4a4f6a;fontStyle=0;fo