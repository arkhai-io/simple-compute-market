#!/bin/sh
# Both public-content checks read the ref updates Git gives on standard input, so
# the updates are read once and given to each; either refuses the push.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
updates=$(cat)
status=0
printf '%s' "$updates" | python3 scripts/check_public_content.py --pre-push "$1" || status=1
printf '%s' "$updates" | python3 scripts/check_secrets.py --pre-push "$1" || status=1
exit "$status"
