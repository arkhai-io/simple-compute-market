<mxCell id="f_config" value="&lt;b&gt;.agents/workflow.toml&lt;/b&gt;&lt;br&gt;the repository's configuration: hooks,&lt;br&gt;parts, models, values; read by config;&lt;br&gt;its commands run by hooks, push, clone" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#ffffff;strokeColor=#8a8fa8;" vertex="1" parent="1"><mxGeometry x="1070" y="946" width="310" height="70" as="geometry"/></mxCell>
