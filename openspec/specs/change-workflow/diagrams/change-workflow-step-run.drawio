<mxCell id="h_unattended" value="&lt;b&gt;An unattended run, and the answer to its question&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2340;" vertex="1" parent="1"><mxGeometry x="175" y="54" width="353" height="19" as="geometry"/></mxCell>
