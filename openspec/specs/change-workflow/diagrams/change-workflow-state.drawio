<mxCell id="title" value="&lt;b&gt;Where a change's state lives&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#1f2340;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="900" height="22" as="geometry"/></mxCell>
<mxCell id="r_ws" value="&lt;b&gt;The owner's workspace&lt;/b&gt;&lt;br&gt;their editor project; a change's workflow meets it for reading" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1f2340;fillColor=#ffffff;strokeColor=#c98ac4;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="500" height="380" as="geometry"/></mxCell>
<mxCell id="w_checkout" value="&lt;b&gt;the owner's checkout&lt;/b&gt;&lt;br&gt;their own branch and edits" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fdf2fb;strokeColor=#c98ac4;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="460" height="55" as="geometry"/></mxCell>
<mxCell id="w_view" value="&lt;b&gt;round view&lt;/b&gt;&lt;br&gt;the change's branch, fast-forwarded from the clone&lt;br&gt;and reset to the round's base; one at a time, its&lt;br&gt;state in the workspace's Git directory" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fdf2fb;strokeColor=#c98ac4;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="w_history" value="&lt;b&gt;history of every cleaned-up change&lt;/b&gt;&lt;br&gt;openspec/changes/archive/&amp;lt;date&amp;gt;-&amp;lt;change&amp;gt;/reviews/&lt;br&gt;and the .snapshot/ evidence its records name,&lt;br&gt;at the same paths as in the clone" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fdf2fb;strokeColor=#c98ac4;" vertex="1" parent="1"><mxGeometry x="50" y="275" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="w_target" value="&lt;b&gt;the clone's workspace remote names it&lt;/b&gt;&lt;br&gt;how every script in a clone finds the workspace" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fdf2fb;strokeColor=#c98ac4;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="460" height="55" as="geometry"/></mxCell>
<mxCell id="r_clone" value="&lt;b&gt;The change's clone&lt;/b&gt;&lt;br&gt;&amp;lt;workspace&amp;gt;.changes/&amp;lt;change&amp;gt;/" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1f2340;fillColor=#ffffff;strokeColor=#e3a765;" vertex="1" parent="1"><mxGeometry x="770" y="60" width="500" height="525" as="geometry"/></mxCell>
<mxCell id="c_clone" value="&lt;b&gt;a clone of the workspace, not a worktree&lt;/b&gt;&lt;br&gt;refs of its own; a local clone hard-links objects" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fff6ec;strokeColor=#e3a765;" vertex="1" parent="1"><mxGeometry x="790" y="120" width="460" height="55" as="geometry"/></mxCell>
<mxCell id="c_branch" value="&lt;b&gt;branch feat/&amp;lt;change&amp;gt;, checked out here&lt;/b&gt;&lt;br&gt;it tracks its name on the push remote, never the workspace" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fff6ec;strokeColor=#e3a765;" vertex="1" parent="1"><mxGeometry x="790" y="190" width="460" height="55" as="geometry"/></mxCell>
<mxCell id="c_reviews" value="&lt;b&gt;openspec/changes/&amp;lt;change&amp;gt;/reviews/&lt;/b&gt;&lt;br&gt;records NN-*.md, the log workflow.jsonl,&lt;br&gt;transcripts/ with each run's .progress;&lt;br&gt;untracked, so no merge carries them" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fff6ec;strokeColor=#e3a765;" vertex="1" parent="1"><mxGeometry x="790" y="275" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="c_remotes" value="&lt;b&gt;remotes&lt;/b&gt;&lt;br&gt;workspace; the upstreams, by the workspace's names" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fff6ec;strokeColor=#e3a765;" vertex="1" parent="1"><mxGeometry x="790" y="360" width="460" height="55" as="geometry"/></mxCell>
<mxCell id="c_env" value="&lt;b&gt;wheelhouse and environments&lt;/b&gt;&lt;br&gt;built by the repository's bootstrap, in the background" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fff6ec;strokeColor=#e3a765;" vertex="1" parent="1"><mxGeometry x="790" y="430" width="460" height="40" as="geometry"/></mxCell>
<mxCell id="c_snapshot" value="&lt;b&gt;.snapshot/&lt;/b&gt;&lt;br&gt;the validation evidence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fff6ec;strokeColor=#e3a765;" vertex="1" parent="1"><mxGeometry x="790" y="480" width="460" height="40" as="geometry"/></mxCell>
<mxCell id="c_gitdir" value="&lt;b&gt;the clone's Git directory&lt;/b&gt;&lt;br&gt;bootstrap state; the runs in progress" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#fff6ec;strokeColor=#e3a765;" vertex="1" parent="1"><mxGeometry x="790" y="530" width="460" height="40" as="geometry"/></mxCell>
<mxCell id="r_origin" value="&lt;b&gt;the branch's remote&lt;/b&gt;&lt;br&gt;its upstream's, read from Git" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1f2340;fillColor=#ffffff;strokeColor=#6fc2a5;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="500" height="180" as="geometry"/></mxCell>
