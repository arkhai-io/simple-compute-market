<mxCell id="o_dev" value="&lt;b&gt;the branch a change lands on&lt;/b&gt;&lt;br&gt;recorded with the clone; where its branch starts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=2;fontSize=12;fontColor=#1f2340;fillColor=#eefaf6;strokeColor=#6fc2a5;" vertex="1" parent="1"><mxGeometry x="50" y="685" width="460" height="40" as="geometry"/></mxCell>
