<mxfile host="app.diagrams.net"><diagram name="On-demand baseline" id="00-on-demand-baseline"><mxGraphModel pageWidth="1180" pageHeight="1020"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="On-demand baseline" style="text;fontSize=22;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="36" as="geometry" /></mxCell><mxCell id="head0" value="Buyer client" style="rounded=1;fillColor=#e8efff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5" y="58" width="210" height="36" as="geometry" /></mxCell><mxCell id="line0" style="dashed=1;endArrow=none;strokeColor=#94a3b8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="94" as="sourcePoint" /><mxPoint x="110" y="910" as="targetPoint" /></mxGeometry></mxCell><mxCell id="head1" value="End service (P / F)" style="rounded=1;fillColor=#e8efff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="245" y="58" width="210" height="36" as="geometry" /></mxCell><mxCell id="line1" style="dashed=1;endArrow=none;strokeColor=#94a3b8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="94" as="sourcePoint" /><mxPoint x="350" y="910" as="targetPoint" /></mxGeometry></mxCell><mxCell id="head2" value="Site" style="rounded=1;fillColor=#e8efff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="485" y="58" width="210" height="36" as="geometry" /></mxCell><mxCell id="line2" style="dashed=1;endArrow=none;strokeColor=#94a3b8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="94" as="sourcePoint" /><mxPoint x="590" y="910" as="targetPoint" /></mxGeometry></mxCell><mxCell id="head3" value="Payment authority" style="rounded=1;fillColor=#e8efff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="725" y="58" width="210" height="36" as="geometry" /></mxCell><mxCell id="line3" style="dashed=1;endArrow=none;strokeColor=#94a3b8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="94" as="sourcePoint" /><mxPoint x="830" y="910" as="targetPoint" /></mxGeometry></mxCell><mxCell id="head4" value="Dispute authority" style="rounded=1;fillColor=#e8efff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="965" y="58" width="210" height="36" as="geometry" /></mxCell><mxCell id="line4" style="dashed=1;endArrow=none;strokeColor=#94a3b8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="94" as="sourcePoint" /><mxPoint x="1070" y="910" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge0" value="1. Approve setup once + rate mandate" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="140" as="sourcePoint" /><mxPoint x="830" y="140" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge1" value="2. commit: keep signed evidence" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="218" as="sourcePoint" /><mxPoint x="350" y="218" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge2" value="3. Provision through unified delivery path" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="296" as="sourcePoint" /><mxPoint x="590" y="296" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge3" value="4. Payee-only start; stable operation key" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="374" as="sourcePoint" /><mxPoint x="830" y="374" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge4" value="5. Activate and disclose after admission checks" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="452" as="sourcePoint" /><mxPoint x="590" y="452" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge5" value="6. Payer stop: priced notice hosted here" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="530" as="sourcePoint" /><mxPoint x="830" y="530" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge6" value="7. end_delivery; signed acknowledgement" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="608" as="sourcePoint" /><mxPoint x="350" y="608" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge7" value="8. P: terminate; record lease_ended" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="686" as="sourcePoint" /><mxPoint x="590" y="686" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge8" value="9. F: stop effective; verify authority effects" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="764" as="sourcePoint" /><mxPoint x="350" y="764" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge9" value="10. Record both completion facts" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="842" as="sourcePoint" /><mxPoint x="420" y="842" as="targetPoint" /></mxGeometry></mxCell><mxCell id="outcome" value="Authority stop and physical recovery are separate completion facts" style="rounded=1;fillColor=#e8f5eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="945" width="1140" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
