etPoint" /></mxGeometry></mxCell><mxCell id="edge5" value="6. Attempt credential disclosure" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="530" as="sourcePoint" /><mxPoint x="350" y="530" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge6" value="7. Refuse: local due end wins" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="608" as="sourcePoint" /><mxPoint x="110" y="608" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge7" value="8. P: adopt dispatched resource and end" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="686" as="sourcePoint" /><mxPoint x="590" y="686" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge8" value="9. Signed lease_ended; physical completion" style="endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="764" as="sourcePoint" /><mxPoint x="350" y="764" as="targetPoint" /></mxGeometry></mxCell><mxCell id="outcome" value="Local admission is serialized; remote observation has a measured window" style="rounded=1;fillColor=#e8f5eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="867" width="1140" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
