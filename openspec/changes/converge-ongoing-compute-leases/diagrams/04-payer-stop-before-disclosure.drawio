<mxfile host="app.diagrams.net"><diagram name="Payer stop before disclosure" id="04-payer-stop-before-disclosure"><mxGraphModel pageWidth="1180" pageHeight="942"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Payer stop before disclosure" style="text;fontSize=22;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="36" as="geometry" /></mxCell><mxCell id="head0" value="Buyer client" style="rounded=1;fillColor=#e8efff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5" y="58" width="210" height="36" as="geometry" /></mxCell><mxCell id="line0" style="dashed=1;endArrow=none;strokeColor=#94a3b8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="94" as="sourcePoint" /><mxPoint x="110" y="832" as="targetPoint" /></mxGeometry></mxCell><mxCell id="head1" value="End service (P / F)" style="rounded=1;fillColor=#e8efff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="245" y="58" width="210" height="36" as="geometry" /></mxCell><mxCell id="line1" style="dashed=1;endArrow=none;strokeColor=#94a3b8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="94" as="sourcePoint" /><mxPoint x="350" y="832" as="targetPoint" /></mxGeometry></mxCell><mxCell id="head2" value="Site" style="rounded=1;fillColor=#e8efff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="485" y="58" width="210" height="36" as="geometry" /></mxCell><mxCell id="line2" style="dashed=1;endArrow=none;strokeColor=#94a3b8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="94" as="sourcePoint" /><mxPoint x="590" y="832" as="targetPoint" /></mxGeometry></mxCell><mxCell id="head3" value="Payment authority" style="rounded=1;fillColor=#e8efff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="725" y="58" width="210" height="36" as="geometry" /></mxCell><mxCell id="line3" style="dashed=1;endArrow=none;strokeColor=#94a3b8;" edge="1" parent="1"><mxGeometry relative="1" as="geometr