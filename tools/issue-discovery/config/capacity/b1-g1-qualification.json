{
  "schema_version": 2,
  "scenario_id": "reference-b1",
  "stage": "reference-b1",
  "description": "Represent one controller-emitted VM lifecycle as product and environment reference evidence, not agent-capacity evidence.",
  "deal_type": "vm",
  "provisioning": "real-kvm-ansible",
  "gpu_assignment": "whole-device-passthrough",
  "counts": {
    "orchestrators": 1,
    "buyers": 1,
    "sellers": 1,
    "hosts": 1,
    "listings": 1,
    "requests": 1,
    "physical_gpus": 1
  },
  "listings": {
    "gpus_per_vm": 1,
    "seller_distribution": [1],
    "frozen_within_series": true,
    "global_physical_gpu_fence": true
  },
  "role_contract": {
    "ownership": "controller-reference",
    "buyer_quickstart": "docs/buyer-quickstart.md",
    "seller_quickstart": "docs/seller-quickstart.md",
    "persistent_buyer_session": false,
    "required_receipts": [
      "cleanup.recorded",
      "controller.authority-checked",
      "controller.observation-recorded",
      "controller.reference-request-invoked",
      "host.provisioning-owned"
