{
  "schema_version": 2,
  "scenario_id": "q5-serialized-reuse",
  "stage": "q5-serialized-reuse",
  "description": "Represent one persistent buyer completing two VM/G1 purchases with terminal teardown and zero residue between requests.",
  "deal_type": "vm",
  "provisioning": "real-kvm-ansible",
  "gpu_assignment": "whole-device-passthrough",
  "counts": {
    "orchestrators": 1,
    "buyers": 1,
    "sellers": 1,
    "hosts": 1,
    "listings": 1,
    "requests": 2,
    "physical_gpus": 1
  },
  "listings": {
    "gpus_per_vm": 1,
    "seller_distribution": [1],
    "frozen_within_series": true,
    "global_physical_gpu_fence": true
  },
  "role_contract": {
    "ownership": "substantive-agents",
    "buyer_quickstart": "docs/buyer-quickstart.md",
    "seller_quickstart": "docs/seller-quickstart.md",
    "persistent_buyer_session": true,
    "required_receipts": [
      "buyer.demand-frozen",
      "buyer.demand-invoked",
      "buyer.quickstart-read",
      "cleanup.recorded",
      "controller.authority-checked",
      "controller.observation-recorded",
      "controller.release-recorded",
      "host.provisioning-owned",
      "seller.listing-published",
      "seller.quickstart-read",
      "seller.service-ready"
    ]
  },
  "arrival": {
    "mode": "serialized-reuse",
    "barrier_participants": 0,
    "teardown_between_requests": true
  },
  "expectations": {
    "successes": 2,
    "scarcity": 0,
    "retry_count": 0,
    "scarcity_contract": {
      "http_status": 409,
      "error": "offer_unfulfillable",
      "reason": "no_matching_inventory"
    }
  },
  "lifecycle": {
    "reservation_identity": "capacity_reservation_id",
    "fulfillment_identity": "fulfillment_id",
    "status_required": true,
    "result_required": true,
    "executor_correlation": "sanitized-presence-only",
    "teardown": "fulfillment-driven"
  },
  "cleanup": {
    "required": true,
    "zero_residue": true,
    "vm_teardown": "immediate",
    "lease": "backstop-only"
  }
