{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-compute-market.dev/schemas/capacity-finding-v1.json",
  "title": "SCM capacity finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "fingerprint",
    "scenario_id",
    "scenario_fingerprint",
    "frontier",
    "classification",
    "destination_repo",
    "summary",
    "expected",
    "actual",
    "evidence",
    "observed",
    "filing_readiness"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "finding_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,79}$" },
    "fingerprint": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "scenario_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "scenario_fingerprint": { "type": "string", "minLength": 1 },
    "frontier": {
      "enum": ["request-processing", "simultaneous-fulfillment", "provisioning", "correctness", "load-generator", "cleanup"]
    },
    "classification": { "enum": ["public-product", "public-harness", "private-infra"] },
    "destination_repo": { "enum": ["simple-compute-market", "compute-market-internal-infra"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "expected": { "type": "string", "minLength": 1 },
    "actual": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[^/].*" }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "stage", "working_branch", "observed_ref"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "working_branch": {
          "enum": ["feat/issue-discovery-harness", "tools/agent-orchestration-scratch"]
        },
        "observed_ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "filing_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "confidence", "reason"],
      "properties": {
        "state": { "enum": ["needs_targeted_repro", "ready_to_file", "environment_only", "harness_gap"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
