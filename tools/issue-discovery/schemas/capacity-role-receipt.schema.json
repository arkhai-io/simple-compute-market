{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-compute-market.dev/schemas/capacity-role-receipt-v2.json",
  "title": "SCM substantive capacity role receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "plan_id", "plan_sha256", "role",
    "actor_slot", "scm_ref", "instruction", "isolated_identity_fingerprint",
    "prepared_authority_sha256", "lifecycle", "barrier", "step_outcomes",
    "role_evidence"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "receipt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "role": {"enum": ["buyer", "seller", "host-operator", "observer"]},
    "actor_slot": {"type": "string", "pattern": "^(?:buyer|seller|host-operator|observer)-[1-9][0-9]*$"},
    "scm_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "instruction": {"$ref": "#/$defs/tracked_content"},
    "isolated_identity_fingerprint": {"$ref": "#/$defs/digest"},
    "prepared_authority_sha256": {"$ref": "#/$defs/digest"},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "prepared_at", "barrier_observed_at", "completed_at"],
      "properties": {
        "started_at": {"$ref": "#/$defs/timestamp"},
        "prepared_at": {"$ref": "#/$defs/timestamp"},
        "barrier_observed_at": {"$ref": "#/$defs/timestamp"},
        "completed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "barrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["barrier_kind", "barrier_id", "actor_alive_at_barrier"],
      "properties": {
        "barrier_kind": {"enum": ["release", "observation", "cleanup"]},
        "barrier_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "actor_alive_at_barrier": {"const": true}
      }
    },
    "step_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "status", "evidence_sha256"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "status": {"const": "passed"},
          "evidence_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "role_evidence": {
      "oneOf": [
        {"$ref": "#/$defs/buyer_evidence"},
        {"$ref": "#/$defs/seller_evidence"},
        {"$ref": "#/$defs/host_evidence"},
        {"$ref": "#/$defs/observer_evidence"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "buyer"}}, "required": ["role"]},
      "then": {"properties": {"actor_slot": {"pattern": "^buyer-[1-9][0-9]*$"}, "role_evidence": {"$ref": "#/$defs/buyer_evidence"}}}
    },
    {
      "if": {"properties": {"role": {"const": "seller"}}, "required": ["role"]},
      "then": {"properties": {"actor_slot": {"pattern": "^seller-[1-9][0-9]*$"}, "role_evidence": {"$ref": "#/$defs/seller_evidence"}}}
    },
    {
      "if": {"properties": {"role": {"const": "host-operator"}}, "required": ["role"]},
      "then": {"properties": {"actor_slot": {"pattern": "^host-operator-[1-9][0-9]*$"}, "role_evidence": {"$ref": "#/$defs/host_evidence"}}}
    },
    {
      "if": {"properties": {"role": {"const": "observer"}}, "required": ["role"]},
      "then": {"properties": {"actor_slot": {"pattern": "^observer-[1-9][0-9]*$"}, "role_evidence": {"$ref": "#/$defs/observer_evidence"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "tracked_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "domain", "value"],
      "properties": {
        "method": {"enum": ["hmac-sha256-v1", "opaque-random-v1"]},
        "domain": {
          "enum": [
            "scm.capacity.topology-authority.v1",
            "scm.capacity.reversible-baseline.v1",
            "scm.capacity.baseline-equivalence.v1",
            "scm.capacity.native-evidence.v1"
          ]
        },
        "value": {"$ref": "#/$defs/digest"}
      }
    },
    "buyer_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action_result_sha256", "guest_verification"],
      "properties": {
        "kind": {"const": "buyer"},
        "action_result_sha256": {"$ref": "#/$defs/digest"},
        "guest_verification": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["fulfillment_id", "ssh_resumed", "visible_gpus", "workload_sha256", "success_marker", "result_checksum"],
              "properties": {
                "fulfillment_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "ssh_resumed": {"const": true},
                "visible_gpus": {"const": 1},
                "workload_sha256": {"$ref": "#/$defs/digest"},
                "success_marker": {"type": "string", "minLength": 1, "maxLength": 128},
                "result_checksum": {"$ref": "#/$defs/digest"}
              }
            }
          ]
        }
      }
    },
    "seller_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "service_start_result_sha256", "publication_result_sha256s", "alive_through_observation"],
      "properties": {
        "kind": {"const": "seller"},
        "service_start_result_sha256": {"$ref": "#/$defs/digest"},
        "publication_result_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        },
        "alive_through_observation": {"const": true}
      }
    },
    "host_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "topology_authority_binding", "reversible_baseline_binding", "baseline_equivalence_binding", "kvm_ansible_ready", "cleanup_complete"],
      "properties": {
        "kind": {"const": "host-operator"},
        "topology_authority_binding": {"$ref": "#/$defs/topology_binding"},
        "reversible_baseline_binding": {"$ref": "#/$defs/reversible_binding"},
        "baseline_equivalence_binding": {"$ref": "#/$defs/equivalence_binding"},
        "kvm_ansible_ready": {"const": true},
        "cleanup_complete": {"type": "boolean"}
      }
    },
    "observer_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "independent_source", "native_evidence_bindings"],
      "properties": {
        "kind": {"const": "observer"},
        "independent_source": {"const": true},
        "native_evidence_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/native_evidence_binding"}
        }
      }
    },
    "topology_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.topology-authority.v1"}}}
      ]
    },
    "reversible_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.reversible-baseline.v1"}}}
      ]
    },
    "equivalence_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.baseline-equivalence.v1"}}}
      ]
    },
    "native_evidence_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.native-evidence.v1"}}}
      ]
    }
  }
}
