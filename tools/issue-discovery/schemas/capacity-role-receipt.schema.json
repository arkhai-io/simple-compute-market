{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-compute-market.dev/schemas/capacity-role-receipt-v2.json",
  "title": "SCM substantive capacity role receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "plan_id", "plan_sha256", "role",
    "actor_slot", "profile_stage_id", "profile_stage_sha256", "scenario_id",
    "scenario_sha256", "scm_ref", "instruction",
    "isolated_identity_fingerprint", "prepared_authority_sha256",
    "run_authority", "provenance", "lifecycle", "barrier", "step_outcomes",
    "role_evidence"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "receipt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "role": {"enum": ["buyer", "seller", "host-operator", "observer"]},
    "actor_slot": {"type": "string", "pattern": "^(?:buyer|seller|host-operator|observer)-[1-9][0-9]*$"},
    "profile_stage_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "profile_stage_sha256": {"$ref": "#/$defs/digest"},
    "scenario_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/scenario_id"}
      ]
    },
    "scenario_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "scm_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "instruction": {"$ref": "#/$defs/tracked_content"},
    "isolated_identity_fingerprint": {"$ref": "#/$defs/digest"},
    "prepared_authority_sha256": {"$ref": "#/$defs/digest"},
    "run_authority": {"$ref": "#/$defs/run_authority"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "controller_authored",
        "actor_invocation_capability_binding",
        "actor_liveness_binding"
      ],
      "properties": {
        "producer": {"const": "actor-process"},
        "controller_authored": {"const": false},
        "actor_invocation_capability_binding": {"$ref": "#/$defs/actor_invocation_binding"},
        "actor_liveness_binding": {"$ref": "#/$defs/native_evidence_binding"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "prepared_at", "barrier_observed_at", "completed_at"],
      "properties": {
        "started_at": {"$ref": "#/$defs/timestamp"},
        "prepared_at": {"$ref": "#/$defs/timestamp"},
        "barrier_observed_at": {"$ref": "#/$defs/timestamp"},
        "completed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "barrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["barrier_kind", "barrier_id", "actor_alive_at_barrier"],
      "properties": {
        "barrier_kind": {"enum": ["release", "observation", "cleanup"]},
        "barrier_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "actor_alive_at_barrier": {"const": true}
      }
    },
    "step_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "status", "evidence_sha256"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "status": {"enum": ["passed", "failed"]},
          "evidence_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "role_evidence": {
      "oneOf": [
        {"$ref": "#/$defs/buyer_evidence"},
        {"$ref": "#/$defs/seller_evidence"},
        {"$ref": "#/$defs/host_evidence"},
        {"$ref": "#/$defs/observer_evidence"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "buyer"}}, "required": ["role"]},
      "then": {"properties": {"actor_slot": {"pattern": "^buyer-[1-9][0-9]*$"}, "scenario_id": {"$ref": "#/$defs/scenario_id"}, "scenario_sha256": {"$ref": "#/$defs/digest"}, "role_evidence": {"$ref": "#/$defs/buyer_evidence"}}}
    },
    {
      "if": {"properties": {"role": {"const": "seller"}}, "required": ["role"]},
      "then": {"properties": {"actor_slot": {"pattern": "^seller-[1-9][0-9]*$"}, "scenario_id": {"$ref": "#/$defs/scenario_id"}, "scenario_sha256": {"$ref": "#/$defs/digest"}, "role_evidence": {"$ref": "#/$defs/seller_evidence"}}}
    },
    {
      "if": {"properties": {"role": {"const": "host-operator"}}, "required": ["role"]},
      "then": {"properties": {"actor_slot": {"pattern": "^host-operator-[1-9][0-9]*$"}, "role_evidence": {"$ref": "#/$defs/host_evidence"}}}
    },
    {
      "if": {"properties": {"role": {"const": "observer"}}, "required": ["role"]},
      "then": {"properties": {"actor_slot": {"pattern": "^observer-[1-9][0-9]*$"}, "role_evidence": {"$ref": "#/$defs/observer_evidence"}}}
    },
    {
      "if": {
        "properties": {"profile_stage_id": {"const": "observer-probe"}},
        "required": ["profile_stage_id"]
      },
      "then": {
        "properties": {
          "scenario_id": {"type": "null"},
          "scenario_sha256": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "scenario_id": {"$ref": "#/$defs/scenario_id"},
          "scenario_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "scenario_id": {
      "type": "string",
      "enum": [
        "b1-s1-g1", "b2-s1-g1", "b3-s1-g1", "b4-s1-g1",
        "b5-s1-g1", "b6-s1-g1", "b7-s1-g1", "b8-s1-g1",
        "serialized-reuse-a", "serialized-reuse-b", "b2-s2-g1",
        "b4-s2-g1", "b4-s3-g1", "b4-s4-g1"
      ]
    },
    "tracked_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "run_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "concurrency_policy_id",
        "concurrency_policy_sha256"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
        },
        "concurrency_policy_id": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
            }
          ]
        },
        "concurrency_policy_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/digest"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "concurrency_policy_id": {"type": "null"},
            "concurrency_policy_sha256": {"type": "null"}
          }
        },
        {
          "properties": {
            "concurrency_policy_id": {"type": "string"},
            "concurrency_policy_sha256": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "domain", "value"],
      "properties": {
        "method": {"enum": ["hmac-sha256-v1", "opaque-random-v1"]},
        "domain": {
          "enum": [
            "scm.capacity.topology-authority.v1",
            "scm.capacity.reversible-baseline.v1",
            "scm.capacity.baseline-equivalence.v1",
            "scm.capacity.native-evidence.v1",
            "scm.capacity.actor-invocation.v1"
          ]
        },
        "value": {"$ref": "#/$defs/digest"}
      }
    },
    "buyer_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action_result_sha256", "guest_verification"],
      "properties": {
        "kind": {"const": "buyer"},
        "action_result_sha256": {"$ref": "#/$defs/digest"},
        "guest_verification": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["fulfillment_id", "ssh_resumed", "visible_gpus", "workload_sha256", "success_marker", "result_checksum"],
              "properties": {
                "fulfillment_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "ssh_resumed": {"const": true},
                "visible_gpus": {"const": 1},
                "workload_sha256": {"$ref": "#/$defs/digest"},
                "success_marker": {"type": "string", "minLength": 1, "maxLength": 128},
                "result_checksum": {"$ref": "#/$defs/digest"}
              }
            }
          ]
        }
      }
    },
    "seller_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "service_start_result_sha256", "publication_result_sha256s", "topology_authority_binding", "alive_through_observation"],
      "properties": {
        "kind": {"const": "seller"},
        "service_start_result_sha256": {"$ref": "#/$defs/digest"},
        "publication_result_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        },
        "topology_authority_binding": {"$ref": "#/$defs/topology_binding"},
        "alive_through_observation": {"const": true}
      }
    },
    "host_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "topology_authority_binding",
        "reversible_baseline_binding",
        "baseline_equivalence_binding",
        "seller_scaling_admission",
        "kvm_ansible_ready",
        "cleanup_complete",
        "baseline_equivalent",
        "active_residue_detected"
      ],
      "properties": {
        "kind": {"const": "host-operator"},
        "topology_authority_binding": {"$ref": "#/$defs/topology_binding"},
        "reversible_baseline_binding": {"$ref": "#/$defs/reversible_binding"},
        "baseline_equivalence_binding": {"$ref": "#/$defs/equivalence_binding"},
        "seller_scaling_admission": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/seller_scaling_admission"}
          ]
        },
        "kvm_ansible_ready": {"const": true},
        "cleanup_complete": {"type": "boolean"},
        "baseline_equivalent": {"type": "boolean"},
        "active_residue_detected": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"baseline_equivalent": {"const": true}},
            "required": ["baseline_equivalent"]
          },
          "then": {
            "properties": {
              "cleanup_complete": {"const": true},
              "active_residue_detected": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {"active_residue_detected": {"const": true}},
            "required": ["active_residue_detected"]
          },
          "then": {
            "properties": {
              "cleanup_complete": {"const": false},
              "baseline_equivalent": {"const": false}
            }
          }
        }
      ]
    },
    "observer_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "independent_source",
        "controller_source",
        "release_observed",
        "terminal_observed",
        "native_evidence_bindings",
        "request_observations",
        "cleanup_observation"
      ],
      "properties": {
        "kind": {"const": "observer"},
        "independent_source": {"const": true},
        "controller_source": {"const": false},
        "release_observed": {"const": true},
        "terminal_observed": {"const": true},
        "native_evidence_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/native_evidence_binding"}
        },
        "request_observations": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/request_observation"}
        },
        "cleanup_observation": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/cleanup_observation"}
          ]
        }
      }
    },
    "request_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_outcome_sha256",
        "native_evidence_binding"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^request-[1-9][0-9]*$"
        },
        "request_outcome_sha256": {"$ref": "#/$defs/digest"},
        "native_evidence_binding": {
          "$ref": "#/$defs/native_evidence_binding"
        }
      }
    },
    "seller_scaling_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_seller_identities",
        "distinct_service_instances",
        "native_evidence_binding"
      ],
      "properties": {
        "distinct_seller_identities": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "distinct_service_instances": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "native_evidence_binding": {
          "$ref": "#/$defs/native_evidence_binding"
        }
      }
    },
    "cleanup_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanup_sha256",
        "stage_started_at",
        "terminal_observed_at",
        "cleanup_completed_at",
        "clock_evidence_binding",
        "native_evidence_binding"
      ],
      "properties": {
        "cleanup_sha256": {"$ref": "#/$defs/digest"},
        "stage_started_at": {"$ref": "#/$defs/timestamp"},
        "terminal_observed_at": {"$ref": "#/$defs/timestamp"},
        "cleanup_completed_at": {"$ref": "#/$defs/timestamp"},
        "clock_evidence_binding": {
          "$ref": "#/$defs/native_evidence_binding"
        },
        "native_evidence_binding": {
          "$ref": "#/$defs/native_evidence_binding"
        }
      }
    },
    "topology_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.topology-authority.v1"}}}
      ]
    },
    "reversible_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.reversible-baseline.v1"}}}
      ]
    },
    "equivalence_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.baseline-equivalence.v1"}}}
      ]
    },
    "native_evidence_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.native-evidence.v1"}}}
      ]
    },
    "actor_invocation_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.actor-invocation.v1"}}}
      ]
    }
  }
}
