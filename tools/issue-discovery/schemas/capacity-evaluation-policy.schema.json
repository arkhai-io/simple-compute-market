{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-compute-market.dev/schemas/capacity-evaluation-policy-v2.json",
  "title": "SCM pre-Q0 capacity evaluation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_policy_id",
    "scm_ref",
    "profile_registry",
    "frozen_at",
    "frozen_before_q0",
    "clock_evidence_binding",
    "request_processing_slo_ns",
    "provisioning_queue_slo_ns",
    "ansible_service_slo_ns",
    "terminal_observation_timeout_ns",
    "frontier_definitions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "evaluation_policy_id": {
      "$ref": "#/$defs/id"
    },
    "scm_ref": {
      "$ref": "#/$defs/ref"
    },
    "profile_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "canonical_sha256",
        "raw_sha256"
      ],
      "properties": {
        "path": {
          "const": "tools/issue-discovery/config/capacity/profiles/g1-v2.json"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/digest"
        },
        "raw_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "frozen_at": {
      "$ref": "#/$defs/timestamp"
    },
    "frozen_before_q0": {
      "const": true
    },
    "clock_evidence_binding": {
      "$ref": "#/$defs/native_evidence_binding"
    },
    "request_processing_slo_ns": {
      "type": "integer",
      "minimum": 1
    },
    "provisioning_queue_slo_ns": {
      "type": "integer",
      "minimum": 1
    },
    "ansible_service_slo_ns": {
      "type": "integer",
      "minimum": 1
    },
    "terminal_observation_timeout_ns": {
      "type": "integer",
      "minimum": 1
    },
    "frontier_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_processing",
        "simultaneous_fulfillment",
        "provisioning",
        "correctness",
        "load_generator"
      ],
      "properties": {
        "request_processing": {
          "const": "all-expected-terminal-within-slo-without-generator-saturation"
        },
        "simultaneous_fulfillment": {
          "const": "maximum-independent-overlapping-whole-gpu-vms"
        },
        "provisioning": {
          "const": "greatest-shape-meeting-queue-and-ansible-slos"
        },
        "correctness": {
          "const": "greatest-shape-with-complete-oracle-cleanup-and-baseline"
        },
        "load_generator": {
          "const": "greatest-shape-with-overlap-skew-liveness-and-no-local-queue"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "native_evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "domain",
        "value"
      ],
      "properties": {
        "method": {
          "enum": [
            "hmac-sha256-v1",
            "opaque-random-v1"
          ]
        },
        "domain": {
          "const": "scm.capacity.native-evidence.v1"
        },
        "value": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
