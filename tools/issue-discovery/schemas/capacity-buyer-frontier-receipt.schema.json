{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-compute-market.dev/schemas/capacity-buyer-frontier-receipt-v2.json",
  "title": "SCM measured buyer-frontier receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frontier_receipt_id",
    "scm_ref",
    "profile_registry",
    "evaluation_policy",
    "ordered_results",
    "initial_stage_ids",
    "refinement_stage_ids",
    "retained_buyer_counts",
    "stage_observations",
    "frontiers",
    "progression",
    "clock_evidence_binding",
    "topology_authority_binding",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "frontier_receipt_id": {
      "$ref": "#/$defs/id"
    },
    "scm_ref": {
      "$ref": "#/$defs/ref"
    },
    "profile_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "canonical_sha256",
        "raw_sha256"
      ],
      "properties": {
        "path": {
          "const": "tools/issue-discovery/config/capacity/profiles/g1-v2.json"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/digest"
        },
        "raw_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_policy_id",
        "evaluation_policy_sha256"
      ],
      "properties": {
        "evaluation_policy_id": {
          "$ref": "#/$defs/id"
        },
        "evaluation_policy_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "ordered_results": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_stage_id",
          "result_id",
          "result_sha256"
        ],
        "properties": {
          "profile_stage_id": {
            "$ref": "#/$defs/buyer_stage_id"
          },
          "result_id": {
            "$ref": "#/$defs/id"
          },
          "result_sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "initial_stage_ids": {
      "type": "array",
      "prefixItems": [
        {
          "const": "q0-b1-s1-g1-measured"
        },
        {
          "const": "b2-s1-g1-measured"
        },
        {
          "const": "b4-s1-g1-measured"
        },
        {
          "const": "b8-s1-g1-measured"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "refinement_stage_ids": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "b3-s1-g1-measured",
          "b5-s1-g1-measured",
          "b6-s1-g1-measured",
          "b7-s1-g1-measured"
        ]
      }
    },
    "retained_buyer_counts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      }
    },
    "stage_observations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_stage_id",
          "buyer_count",
          "request_processing_passed",
          "provisioning_passed",
          "correctness_passed",
          "load_generator_passed",
          "progression_passed"
        ],
        "properties": {
          "profile_stage_id": {
            "$ref": "#/$defs/buyer_stage_id"
          },
          "buyer_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "request_processing_passed": {
            "type": "boolean"
          },
          "provisioning_passed": {
            "type": "boolean"
          },
          "correctness_passed": {
            "type": "boolean"
          },
          "load_generator_passed": {
            "type": "boolean"
          },
          "progression_passed": {
            "type": "boolean"
          }
        }
      }
    },
    "frontiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_processing",
        "simultaneous_fulfillment",
        "provisioning",
        "correctness",
        "load_generator"
      ],
      "properties": {
        "request_processing": {
          "$ref": "#/$defs/shape_frontier"
        },
        "simultaneous_fulfillment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximum_whole_gpu_vms",
            "classification"
          ],
          "properties": {
            "maximum_whole_gpu_vms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "classification": {
              "enum": [
                "exact-observation",
                "not-observed"
              ]
            }
          }
        },
        "provisioning": {
          "$ref": "#/$defs/shape_frontier"
        },
        "correctness": {
          "$ref": "#/$defs/shape_frontier"
        },
        "load_generator": {
          "$ref": "#/$defs/shape_frontier"
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_predicate",
        "largest_clean_buyer_count",
        "classification",
        "lower_bound_reason",
        "completed_before_reuse"
      ],
      "properties": {
        "selection_predicate": {
          "const": "request-processing-and-provisioning-and-correctness-with-load-generator-censoring"
        },
        "largest_clean_buyer_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "classification": {
          "enum": [
            "exact-bound",
            "lower-bound",
            "no-clean-shape"
          ]
        },
        "lower_bound_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "frozen-envelope-ended",
                "load-generator-ended-first"
              ]
            }
          ]
        },
        "completed_before_reuse": {
          "const": true
        }
      }
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "clock_evidence_binding": {
      "$ref": "#/$defs/native_evidence_binding"
    },
    "topology_authority_binding": {
      "$ref": "#/$defs/topology_authority_binding"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "domain",
        "value"
      ],
      "properties": {
        "method": {
          "enum": [
            "hmac-sha256-v1",
            "opaque-random-v1"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "native_evidence_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "domain": {
              "const": "scm.capacity.native-evidence.v1"
            }
          }
        }
      ]
    },
    "topology_authority_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "domain": {
              "const": "scm.capacity.topology-authority.v1"
            }
          }
        }
      ]
    },
    "buyer_stage_id": {
      "enum": [
        "q0-b1-s1-g1-measured",
        "b2-s1-g1-measured",
        "b3-s1-g1-measured",
        "b4-s1-g1-measured",
        "b5-s1-g1-measured",
        "b6-s1-g1-measured",
        "b7-s1-g1-measured",
        "b8-s1-g1-measured"
      ]
    },
    "shape_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "greatest_passing_buyer_count",
        "classification",
        "limit_reason"
      ],
      "properties": {
        "greatest_passing_buyer_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "classification": {
          "enum": [
            "exact-bound",
            "lower-bound",
            "not-observed"
          ]
        },
        "limit_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "observed-failure",
                "frozen-envelope-ended",
                "load-generator-ended-first",
                "no-passing-shape"
              ]
            }
          ]
        }
      }
    }
  }
}
