{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-compute-market.dev/schemas/capacity-scenario-v2.json",
  "title": "SCM agent-driven VM/G1 capacity scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "stage",
    "description",
    "deal_type",
    "provisioning",
    "gpu_assignment",
    "counts",
    "listings",
    "bindings",
    "role_contract",
    "arrival",
    "expectations",
    "lifecycle",
    "cleanup"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "scenario_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "stage": {
      "enum": [
        "q0-host-capability",
        "reference-b1",
        "q1-b1-s1-g1",
        "q2-b2-s1-g1",
        "q3-b4-s1-g1",
        "q4-b8-s1-g1",
        "q5-serialized-reuse",
        "q6-b2-s2-g1",
        "q7-b4-s2-g1",
        "q8-b4-s4-g1"
      ]
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 240 },
    "deal_type": { "const": "vm" },
    "provisioning": { "const": "real-kvm-ansible" },
    "gpu_assignment": { "const": "whole-device-passthrough" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestrators",
        "buyers",
        "sellers",
        "hosts",
        "listings",
        "requests",
        "physical_gpus"
      ],
      "properties": {
        "orchestrators": { "const": 1 },
        "buyers": { "type": "integer", "minimum": 0, "maximum": 8 },
        "sellers": { "type": "integer", "minimum": 0, "maximum": 4 },
        "hosts": { "const": 1 },
        "listings": { "type": "integer", "minimum": 0, "maximum": 4 },
        "requests": { "type": "integer", "minimum": 0, "maximum": 8 },
        "physical_gpus": { "const": 1 }
      }
    },
    "listings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpus_per_vm",
        "seller_distribution",
        "frozen_within_series",
        "global_physical_gpu_fence"
      ],
      "properties": {
        "gpus_per_vm": { "const": 1 },
        "seller_distribution": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "integer", "minimum": 1, "maximum": 1 }
        },
        "frozen_within_series": { "const": true },
        "global_physical_gpu_fence": { "const": true }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id_scheme",
        "listing_assignment",
        "request_assignment",
        "listing_set_sha256",
        "demand_set_sha256"
      ],
      "properties": {
        "role_id_scheme": { "const": "ordinal-v1" },
        "listing_assignment": { "enum": ["none", "seller-ordinal"] },
        "request_assignment": {
          "enum": [
            "none",
            "controller-reference",
            "buyer-ordinal",
            "single-persistent-buyer"
          ]
        },
        "listing_set_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "demand_set_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "role_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "buyer_quickstart",
        "seller_quickstart",
        "same_session_prepare_wait_invoke",
        "persistent_across_requests",
        "required_receipts"
      ],
      "properties": {
        "ownership": {
          "enum": ["host-agent", "controller-reference", "substantive-agents"]
        },
        "buyer_quickstart": { "const": "docs/buyer-quickstart.md" },
        "seller_quickstart": { "const": "docs/seller-quickstart.md" },
        "same_session_prepare_wait_invoke": { "type": "boolean" },
        "persistent_across_requests": { "type": "boolean" },
        "required_receipts": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "buyer.demand-frozen",
              "buyer.demand-invoked",
              "buyer.quickstart-read",
              "buyer.same-session-invocation",
              "cleanup.recorded",
              "controller.authority-checked",
              "controller.observation-recorded",
              "controller.reference-request-invoked",
              "controller.release-recorded",
              "host.provisioning-owned",
              "host.provisioning-preflight",
              "seller.listing-published",
              "seller.quickstart-read",
              "seller.service-ready"
            ]
          }
        }
      }
    },
    "arrival": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "barrier_participants", "teardown_between_requests"],
      "properties": {
        "mode": { "enum": ["none", "release-barrier", "serialized-reuse"] },
        "barrier_participants": { "type": "integer", "minimum": 0, "maximum": 8 },
        "teardown_between_requests": { "type": "boolean" }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["successes", "scarcity", "retry_count", "scarcity_contract"],
      "properties": {
        "successes": { "type": "integer", "minimum": 0, "maximum": 8 },
        "scarcity": { "type": "integer", "minimum": 0, "maximum": 8 },
        "retry_count": { "const": 0 },
        "scarcity_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http_status", "error", "reason"],
          "properties": {
            "http_status": { "const": 409 },
            "error": { "const": "offer_unfulfillable" },
            "reason": { "const": "no_matching_inventory" }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "reservation_identity",
        "fulfillment_identity",
        "reservation_fulfillment_correlation_required",
        "terminal_status_required",
        "versioned_result_required",
        "executor_ref_target_correlation",
        "fulfillment_teardown_required"
      ],
      "properties": {
        "applicability": { "enum": ["not-applicable", "market-request"] },
        "reservation_identity": {
          "enum": ["not-applicable", "capacity_reservation_id"]
        },
        "fulfillment_identity": {
          "enum": ["not-applicable", "fulfillment_id"]
        },
        "reservation_fulfillment_correlation_required": { "type": "boolean" },
        "terminal_status_required": { "type": "boolean" },
        "versioned_result_required": { "type": "boolean" },
        "executor_ref_target_correlation": {
          "enum": ["not-applicable", "sanitized-assertion"]
        },
        "fulfillment_teardown_required": { "type": "boolean" }
      },
      "oneOf": [
        {
          "properties": {
            "applicability": { "const": "not-applicable" },
            "reservation_identity": { "const": "not-applicable" },
            "fulfillment_identity": { "const": "not-applicable" },
            "reservation_fulfillment_correlation_required": { "const": false },
            "terminal_status_required": { "const": false },
            "versioned_result_required": { "const": false },
            "executor_ref_target_correlation": { "const": "not-applicable" },
            "fulfillment_teardown_required": { "const": false }
          }
        },
        {
          "properties": {
            "applicability": { "const": "market-request" },
            "reservation_identity": { "const": "capacity_reservation_id" },
            "fulfillment_identity": { "const": "fulfillment_id" },
            "reservation_fulfillment_correlation_required": { "const": true },
            "terminal_status_required": { "const": true },
            "versioned_result_required": { "const": true },
            "executor_ref_target_correlation": { "const": "sanitized-assertion" },
            "fulfillment_teardown_required": { "const": true }
          }
        }
      ]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "zero_residue", "vm_teardown", "lease"],
      "properties": {
        "required": { "const": true },
        "zero_residue": { "const": true },
        "vm_teardown": { "enum": ["not-applicable", "immediate"] },
        "lease": { "enum": ["not-applicable", "backstop-only"] }
      }
    }
  }
}
