{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-compute-market.dev/schemas/capacity-role-plan-v2.json",
  "title": "SCM substantive capacity role plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "role",
    "actor_slot",
    "profile_stage_id",
    "profile_stage_sha256",
    "scenario_id",
    "scenario_sha256",
    "scm_ref",
    "instruction",
    "isolated_identity_fingerprint",
    "actor_invocation_capability_binding",
    "prepared_authority_sha256",
    "role_plan"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "role": {"enum": ["buyer", "seller", "host-operator", "observer"]},
    "actor_slot": {"type": "string", "pattern": "^(?:buyer|seller|host-operator|observer)-[1-9][0-9]*$"},
    "profile_stage_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "profile_stage_sha256": {"$ref": "#/$defs/digest"},
    "scenario_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/scenario_id"}
      ]
    },
    "scenario_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "scm_ref": {"$ref": "#/$defs/ref"},
    "instruction": {"$ref": "#/$defs/tracked_content"},
    "isolated_identity_fingerprint": {"$ref": "#/$defs/digest"},
    "actor_invocation_capability_binding": {"$ref": "#/$defs/actor_invocation_binding"},
    "prepared_authority_sha256": {"$ref": "#/$defs/digest"},
    "role_plan": {
      "oneOf": [
        {"$ref": "#/$defs/buyer_plan"},
        {"$ref": "#/$defs/seller_plan"},
        {"$ref": "#/$defs/host_plan"},
        {"$ref": "#/$defs/observer_plan"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "buyer"}}, "required": ["role"]},
      "then": {
        "properties": {
          "actor_slot": {"pattern": "^buyer-[1-9][0-9]*$"},
          "scenario_id": {"$ref": "#/$defs/scenario_id"},
          "scenario_sha256": {"$ref": "#/$defs/digest"},
          "role_plan": {"$ref": "#/$defs/buyer_plan"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "seller"}}, "required": ["role"]},
      "then": {
        "properties": {
          "actor_slot": {"pattern": "^seller-[1-9][0-9]*$"},
          "scenario_id": {"$ref": "#/$defs/scenario_id"},
          "scenario_sha256": {"$ref": "#/$defs/digest"},
          "role_plan": {"$ref": "#/$defs/seller_plan"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "host-operator"}}, "required": ["role"]},
      "then": {
        "properties": {
          "actor_slot": {"pattern": "^host-operator-[1-9][0-9]*$"},
          "role_plan": {"$ref": "#/$defs/host_plan"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "observer"}}, "required": ["role"]},
      "then": {
        "properties": {
          "actor_slot": {"pattern": "^observer-[1-9][0-9]*$"},
          "role_plan": {"$ref": "#/$defs/observer_plan"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile_stage_id": {"const": "observer-probe"}
        },
        "required": ["profile_stage_id"]
      },
      "then": {
        "properties": {
          "scenario_id": {"type": "null"},
          "scenario_sha256": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "scenario_id": {"$ref": "#/$defs/scenario_id"},
          "scenario_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scenario_id": {
      "type": "string",
      "enum": [
        "b1-s1-g1", "b2-s1-g1", "b3-s1-g1", "b4-s1-g1",
        "b5-s1-g1", "b6-s1-g1", "b7-s1-g1", "b8-s1-g1",
        "serialized-reuse-a", "serialized-reuse-b", "b2-s2-g1",
        "b4-s2-g1", "b4-s3-g1", "b4-s4-g1"
      ]
    },
    "tracked_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "domain", "value"],
      "properties": {
        "method": {"enum": ["hmac-sha256-v1", "opaque-random-v1"]},
        "domain": {
          "enum": [
            "scm.capacity.topology-authority.v1",
            "scm.capacity.reversible-baseline.v1",
            "scm.capacity.baseline-equivalence.v1",
            "scm.capacity.native-evidence.v1",
            "scm.capacity.actor-invocation.v1"
          ]
        },
        "value": {"$ref": "#/$defs/digest"}
      }
    },
    "buyer_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "action_id",
        "prepared_action_sha256",
        "preparation_steps",
        "success_steps",
        "guest_exercise"
      ],
      "properties": {
        "kind": {"const": "buyer"},
        "request_id": {"type": "string", "pattern": "^request-[1-9][0-9]*$"},
        "action_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "prepared_action_sha256": {"$ref": "#/$defs/digest"},
        "preparation_steps": {
          "const": [
            "install-build", "wallet-preparation", "ssh-preparation",
            "endpoint-check", "balance-check", "listing-discovery",
            "request-preparation"
          ]
        },
        "success_steps": {
          "const": [
            "guest-ssh-resume", "cuda-vector-add"
          ]
        },
        "guest_exercise": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wrapper", "source"],
          "properties": {
            "wrapper": {"$ref": "#/$defs/tracked_content"},
            "source": {"$ref": "#/$defs/tracked_content"}
          }
        }
      }
    },
    "seller_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "service_slot",
        "listing_slots",
        "service_start_action_id",
        "service_start_prepared_action_sha256",
        "publication_action_ids",
        "publication_prepared_action_sha256s",
        "topology_authority_binding",
        "required_steps"
      ],
      "properties": {
        "kind": {"const": "seller"},
        "service_slot": {"type": "string", "pattern": "^seller-service-[1-9][0-9]*$"},
        "listing_slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^listing-[1-9][0-9]*$"}
        },
        "service_start_action_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "service_start_prepared_action_sha256": {"$ref": "#/$defs/digest"},
        "publication_action_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "publication_prepared_action_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        },
        "topology_authority_binding": {"$ref": "#/$defs/topology_binding"},
        "required_steps": {
          "const": [
            "install-build", "configuration", "wallet-preparation",
            "publication-preparation", "service-start", "listing-publication",
            "observation-liveness"
          ]
        }
      }
    },
    "host_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "topology_authority_binding", "reversible_baseline_binding",
        "baseline_equivalence_binding", "admitted_gpus", "kvm_ansible_readiness",
        "observation_plan_sha256", "teardown_plan_sha256",
        "seller_scaling_admission"
      ],
      "properties": {
        "kind": {"const": "host-operator"},
        "topology_authority_binding": {"$ref": "#/$defs/topology_binding"},
        "reversible_baseline_binding": {"$ref": "#/$defs/reversible_binding"},
        "baseline_equivalence_binding": {"$ref": "#/$defs/equivalence_binding"},
        "admitted_gpus": {"const": 1},
        "kvm_ansible_readiness": {"const": true},
        "observation_plan_sha256": {"$ref": "#/$defs/digest"},
        "teardown_plan_sha256": {"$ref": "#/$defs/digest"},
        "seller_scaling_admission": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/seller_scaling_admission"}
          ]
        }
      }
    },
    "seller_scaling_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_seller_identities",
        "distinct_service_instances",
        "native_evidence_binding"
      ],
      "properties": {
        "distinct_seller_identities": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "distinct_service_instances": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "native_evidence_binding": {
          "$ref": "#/$defs/native_evidence_binding"
        }
      }
    },
    "observer_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "independent_source_plan_sha256", "native_evidence_bindings"],
      "properties": {
        "kind": {"const": "observer"},
        "independent_source_plan_sha256": {"$ref": "#/$defs/digest"},
        "native_evidence_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/native_evidence_binding"}
        }
      }
    },
    "topology_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.topology-authority.v1"}}}
      ]
    },
    "reversible_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.reversible-baseline.v1"}}}
      ]
    },
    "equivalence_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.baseline-equivalence.v1"}}}
      ]
    },
    "native_evidence_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.native-evidence.v1"}}}
      ]
    },
    "actor_invocation_binding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"domain": {"const": "scm.capacity.actor-invocation.v1"}}}
      ]
    }
  }
}
