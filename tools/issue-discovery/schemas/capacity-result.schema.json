{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-compute-market.dev/schemas/capacity-result-v2.json",
  "title": "SCM independently observed VM capacity result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "scm_ref",
    "profile_stage_id",
    "profile_stage_sha256",
    "scenario_id",
    "scenario_sha256",
    "execution_boundary",
    "actor_trigger",
    "evaluation_policy",
    "oracle_authority",
    "execution_authority",
    "topology_authority_binding",
    "started_at",
    "terminal_observed_at",
    "cleanup_completed_at",
    "progression_ready_at",
    "expected_outcomes",
    "observed_outcomes",
    "request_outcomes",
    "aggregate_observation",
    "cleanup",
    "stage_assessment",
    "buyer_frontier_authority",
    "reuse_predecessor",
    "seller_progression_authority",
    "frontier_observation"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "result_id": {
      "$ref": "#/$defs/id"
    },
    "scm_ref": {
      "$ref": "#/$defs/ref"
    },
    "profile_stage_id": {
      "$ref": "#/$defs/id"
    },
    "profile_stage_sha256": {
      "$ref": "#/$defs/digest"
    },
    "scenario_id": {
      "$ref": "#/$defs/scenario_id"
    },
    "scenario_sha256": {
      "$ref": "#/$defs/digest"
    },
    "execution_boundary": {
      "enum": [
        "real-reference",
        "real-qualification",
        "real-measured"
      ]
    },
    "actor_trigger": {
      "enum": [
        "controller-driven",
        "agent-triggered"
      ]
    },
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_policy_id",
        "evaluation_policy_sha256"
      ],
      "properties": {
        "evaluation_policy_id": {
          "$ref": "#/$defs/id"
        },
        "evaluation_policy_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "oracle_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_authority_id",
        "oracle_authority_sha256",
        "observer_plan_sha256"
      ],
      "properties": {
        "oracle_authority_id": {
          "$ref": "#/$defs/id"
        },
        "oracle_authority_sha256": {
          "$ref": "#/$defs/digest"
        },
        "observer_plan_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "execution_authority": {
      "oneOf": [
        {
          "$ref": "#/$defs/agent_execution_authority"
        },
        {
          "$ref": "#/$defs/reference_execution_authority"
        }
      ]
    },
    "topology_authority_binding": {
      "$ref": "#/$defs/topology_binding"
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "terminal_observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "cleanup_completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "progression_ready_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expected_outcomes": {
      "$ref": "#/$defs/outcome_counts"
    },
    "observed_outcomes": {
      "$ref": "#/$defs/outcome_counts"
    },
    "request_outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/request_outcome"
      }
    },
    "aggregate_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_plan_sha256",
        "observed_request_ids",
        "request_timing_observations",
        "observed_at",
        "common_clock_binding",
        "native_evidence_bindings",
        "max_overlapping_whole_gpu_vms"
      ],
      "properties": {
        "observer_plan_sha256": {
          "$ref": "#/$defs/digest"
        },
        "observed_request_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/request_id"
          }
        },
        "request_timing_observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "invoked_offset_ns",
              "terminal_offset_ns",
              "native_evidence_binding"
            ],
            "properties": {
              "request_id": {
                "$ref": "#/$defs/request_id"
              },
              "invoked_offset_ns": {
                "type": "integer",
                "minimum": 0
              },
              "terminal_offset_ns": {
                "type": "integer",
                "minimum": 1
              },
              "native_evidence_binding": {
                "$ref": "#/$defs/native_evidence_binding"
              }
            }
          }
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "common_clock_binding": {
          "$ref": "#/$defs/native_evidence_binding"
        },
        "native_evidence_bindings": {
          "$ref": "#/$defs/nonempty_native_evidence_bindings"
        },
        "max_overlapping_whole_gpu_vms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    },
    "stage_assessment": {
      "$ref": "#/$defs/stage_assessment"
    },
    "buyer_frontier_authority": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/buyer_frontier_authority"
        }
      ]
    },
    "reuse_predecessor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/reuse_predecessor"
        }
      ]
    },
    "seller_progression_authority": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/seller_progression_authority"
        }
      ]
    },
    "frontier_observation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/frontier_observation"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario_id": {
            "enum": [
              "serialized-reuse-a",
              "serialized-reuse-b"
            ]
          },
          "execution_boundary": {
            "const": "real-measured"
          }
        },
        "required": [
          "scenario_id",
          "execution_boundary"
        ]
      },
      "then": {
        "properties": {
          "buyer_frontier_authority": {
            "$ref": "#/$defs/buyer_frontier_authority"
          }
        }
      },
      "else": {
        "properties": {
          "buyer_frontier_authority": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario_id": {
            "const": "serialized-reuse-b"
          }
        },
        "required": [
          "scenario_id"
        ]
      },
      "then": {
        "properties": {
          "reuse_predecessor": {
            "$ref": "#/$defs/reuse_predecessor"
          }
        }
      },
      "else": {
        "properties": {
          "reuse_predecessor": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_boundary": {
            "const": "real-reference"
          }
        },
        "required": [
          "execution_boundary"
        ]
      },
      "then": {
        "properties": {
          "actor_trigger": {
            "const": "controller-driven"
          },
          "execution_authority": {
            "$ref": "#/$defs/reference_execution_authority"
          },
          "frontier_observation": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "actor_trigger": {
            "const": "agent-triggered"
          },
          "execution_authority": {
            "$ref": "#/$defs/agent_execution_authority"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_boundary": {
            "const": "real-measured"
          }
        },
        "required": [
          "execution_boundary"
        ]
      },
      "then": {
        "properties": {
          "frontier_observation": {
            "$ref": "#/$defs/frontier_observation"
          }
        }
      },
      "else": {
        "properties": {
          "frontier_observation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile_stage_id": {
            "enum": [
              "b2-s2-g1-measured",
              "b4-s2-g1-measured",
              "b4-s3-g1-measured",
              "b4-s4-g1-measured"
            ]
          }
        },
        "required": [
          "profile_stage_id"
        ]
      },
      "then": {
        "properties": {
          "seller_progression_authority": {
            "$ref": "#/$defs/seller_progression_authority"
          }
        }
      },
      "else": {
        "properties": {
          "seller_progression_authority": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^request-[1-9][0-9]*$"
    },
    "scenario_id": {
      "type": "string",
      "enum": [
        "b1-s1-g1",
        "b2-s1-g1",
        "b3-s1-g1",
        "b4-s1-g1",
        "b5-s1-g1",
        "b6-s1-g1",
        "b7-s1-g1",
        "b8-s1-g1",
        "serialized-reuse-a",
        "serialized-reuse-b",
        "b2-s2-g1",
        "b4-s2-g1",
        "b4-s3-g1",
        "b4-s4-g1"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "nullable_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "domain",
        "value"
      ],
      "properties": {
        "method": {
          "enum": [
            "hmac-sha256-v1",
            "opaque-random-v1"
          ]
        },
        "domain": {
          "enum": [
            "scm.capacity.runtime-binding.v1",
            "scm.capacity.topology-authority.v1",
            "scm.capacity.reversible-baseline.v1",
            "scm.capacity.baseline-equivalence.v1",
            "scm.capacity.native-evidence.v1"
          ]
        },
        "value": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "runtime_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "domain": {
              "const": "scm.capacity.runtime-binding.v1"
            }
          }
        }
      ]
    },
    "topology_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "domain": {
              "const": "scm.capacity.topology-authority.v1"
            }
          }
        }
      ]
    },
    "reversible_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "domain": {
              "const": "scm.capacity.reversible-baseline.v1"
            }
          }
        }
      ]
    },
    "equivalence_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "domain": {
              "const": "scm.capacity.baseline-equivalence.v1"
            }
          }
        }
      ]
    },
    "native_evidence_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "domain": {
              "const": "scm.capacity.native-evidence.v1"
            }
          }
        }
      ]
    },
    "nonempty_native_evidence_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/native_evidence_binding"
      }
    },
    "outcome_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vm-succeeded",
        "capacity-refused",
        "fault"
      ],
      "properties": {
        "vm-succeeded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "capacity-refused": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "fault": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "agent_execution_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor_set_id",
        "actor_set_sha256",
        "release_id",
        "concurrency_policy_id",
        "concurrency_policy_sha256"
      ],
      "properties": {
        "kind": {
          "const": "agent-actor-set"
        },
        "actor_set_id": {
          "$ref": "#/$defs/id"
        },
        "actor_set_sha256": {
          "$ref": "#/$defs/digest"
        },
        "release_id": {
          "$ref": "#/$defs/id"
        },
        "concurrency_policy_id": {
          "$ref": "#/$defs/id"
        },
        "concurrency_policy_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "reference_execution_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference_execution_binding",
        "reference_policy_id",
        "reference_policy_sha256",
        "observer_receipt_id",
        "observer_receipt_sha256",
        "host_receipt_id",
        "host_receipt_sha256",
        "clock_evidence_binding",
        "request_timing_observations",
        "controller_is_counted",
        "release_id",
        "released_at"
      ],
      "properties": {
        "kind": {
          "const": "controller-reference"
        },
        "reference_execution_binding": {
          "$ref": "#/$defs/native_evidence_binding"
        },
        "reference_policy_id": {
          "$ref": "#/$defs/id"
        },
        "reference_policy_sha256": {
          "$ref": "#/$defs/digest"
        },
        "observer_receipt_id": {
          "$ref": "#/$defs/id"
        },
        "observer_receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "host_receipt_id": {
          "$ref": "#/$defs/id"
        },
        "host_receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "clock_evidence_binding": {
          "$ref": "#/$defs/native_evidence_binding"
        },
        "request_timing_observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "invoked_offset_ns",
              "terminal_offset_ns",
              "native_evidence_binding"
            ],
            "properties": {
              "request_id": {
                "$ref": "#/$defs/request_id"
              },
              "invoked_offset_ns": {
                "type": "integer",
                "minimum": 0
              },
              "terminal_offset_ns": {
                "type": "integer",
                "minimum": 1
              },
              "native_evidence_binding": {
                "$ref": "#/$defs/native_evidence_binding"
              }
            }
          }
        },
        "controller_is_counted": {
          "const": false
        },
        "release_id": {
          "$ref": "#/$defs/id"
        },
        "released_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "deal_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "seller_slot",
        "listing_slot",
        "runtime_binding",
        "negotiation_reference_sha256",
        "escrow_reference_sha256"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "seller_slot": {
          "type": "string",
          "pattern": "^seller-[1-9][0-9]*$"
        },
        "listing_slot": {
          "type": "string",
          "pattern": "^listing-[1-9][0-9]*$"
        },
        "runtime_binding": {
          "$ref": "#/$defs/runtime_binding"
        },
        "negotiation_reference_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "escrow_reference_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        }
      }
    },
    "settlement_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_reservation_id",
        "fulfillment_id",
        "state",
        "selected_resource_binding",
        "active_claim"
      ],
      "properties": {
        "capacity_reservation_id": {
          "$ref": "#/$defs/id"
        },
        "fulfillment_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "state": {
          "enum": [
            "assigned",
            "dispatch_pending",
            "dispatching",
            "active",
            "failed",
            "teardown_dispatch_pending",
            "tearing_down",
            "torn_down",
            "teardown_failed",
            "abandoned"
          ]
        },
        "selected_resource_binding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/native_evidence_binding"
            }
          ]
        },
        "active_claim": {
          "type": "boolean"
        }
      }
    },
    "commercial_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deal_state",
        "escrow_state",
        "failure_policy_state",
        "zero_active_claims",
        "zero_active_locks",
        "zero_run_owned_funds"
      ],
      "properties": {
        "deal_state": {
          "enum": [
            "fulfilled-terminal",
            "refused-terminal",
            "failed-terminal",
            "nonterminal",
            "unknown"
          ]
        },
        "escrow_state": {
          "enum": [
            "released",
            "refunded",
            "compensated",
            "locked",
            "unknown"
          ]
        },
        "failure_policy_state": {
          "enum": [
            "not-applicable",
            "compensated",
            "uncompensated",
            "pending",
            "unknown"
          ]
        },
        "zero_active_claims": {
          "type": "boolean"
        },
        "zero_active_locks": {
          "type": "boolean"
        },
        "zero_run_owned_funds": {
          "type": "boolean"
        }
      }
    },
    "request_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teardown_complete",
        "zero_active_residue",
        "native_evidence_binding"
      ],
      "properties": {
        "teardown_complete": {
          "type": "boolean"
        },
        "zero_active_residue": {
          "type": "boolean"
        },
        "native_evidence_binding": {
          "$ref": "#/$defs/native_evidence_binding"
        }
      }
    },
    "request_common": {
      "type": "object",
      "required": [
        "request_id",
        "outcome_kind",
        "deal_reference",
        "invoked_offset_ns",
        "terminal_offset_ns",
        "capacity_reservation_id",
        "fulfillment_id",
        "settlement_record",
        "provisioned_resource_id",
        "allocation_id",
        "provisioning_job_id",
        "commercial_resolution",
        "independent_observation_bindings",
        "request_cleanup",
        "failure_category"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "outcome_kind": {
          "enum": [
            "vm-succeeded",
            "capacity-refused",
            "fault"
          ]
        },
        "deal_reference": {
          "$ref": "#/$defs/deal_reference"
        },
        "invoked_offset_ns": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_offset_ns": {
          "type": "integer",
          "minimum": 1
        },
        "capacity_reservation_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "fulfillment_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "settlement_record": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/settlement_record"
            }
          ]
        },
        "provisioned_resource_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "allocation_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "provisioning_job_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "commercial_resolution": {
          "$ref": "#/$defs/commercial_resolution"
        },
        "independent_observation_bindings": {
          "$ref": "#/$defs/nonempty_native_evidence_bindings"
        },
        "request_cleanup": {
          "$ref": "#/$defs/request_cleanup"
        },
        "failure_category": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "generic-failure",
                "provisioning-error",
                "policy-denial",
                "unknown-reason",
                "uncompensated",
                "atomic-refusal-incomplete",
                "timeout",
                "missing-durable-correlation",
                "cleanup-incomplete",
                "generator-failure"
              ]
            }
          ]
        }
      }
    },
