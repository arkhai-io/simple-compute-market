# EXAMPLE ONLY: RFC 5737 documentation addresses and invented names below are
# deterministic development examples. Never use them on a public network.
# Render config-real-provisioning-target.yml locally (Git ignores it), then use
# ACTIVE_PROFILES=local,real-provisioning-target. Service-side key paths are
# references only; no private key, relay token or grant key belongs in this file.
REAL_PROVISIONING_TARGET:
  version: 2
  hosts:
    - host_id: example-kvm-1
      domain: vm
      connection:
        ssh_host: 198.51.100.20
        ssh_user: provisioner
        ssh_port: 6001
        ssh_key_path: /run/secrets/example-host-key
      access:
        mode: direct
        public_host: 192.0.2.10
      capacity: {vcpu_count: 4, ram_gb: 8, disk_gb: 60}
      listing_shape: {vcpu_count: 2, ram_gb: 3, disk_gb: 25}
      # Optional: the operator's management client on the host, a systemd
      # service (invented name), for host diagnostics to report beside the
      # host's own units.
      # management_unit: example-agent.service
      # Optional: the VM host's independently confirmed OpenSSH public key.
      # Without it the host must already hold a pin in the provisioning service,
      # stated by an earlier run or captured by an operator who compared its
      # fingerprint; the scenario refuses an unpinned host rather than trusting
      # the key it presents.
      # Deterministic test fixture only, never a public-network identity.
      # ssh_host_public_key: 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFJSUlJSUlJSUlJSUlJSUlJSUlJSUlJSUlJSUlJSUlJS'
      # Optional: the inputs of e2e_vm_guest_isolation's host-side stages, which
      # restart libvirtd, reload UFW and alter a running guest on this host.
      # Without it those stages skip, naming guest_isolation. The operator route
      # and its key path are harness-local and invented here; the key is
      # referenced, never copied. Neither private destination needs to answer;
      # both are invented private addresses, and host preparation must have
      # been given the listed one in guest_allowed_private_destinations.
      # guest_isolation:
      #   operator:
      #     host: 127.0.0.1
      #     port: 16002
      #     user: example-observer
      #     key_path: /run/secrets/example-observer-key
      #   private_destinations:
      #     refused: 10.20.0.7
      #     listed: 10.20.0.8
    - host_id: example-bm-1
      domain: bare_metal
      physical_host_id: example-machine-1
      connection:
        ssh_host: 198.51.100.20
        ssh_user: provisioner
        ssh_port: 6002
        ssh_key_path: /run/secrets/example-host-key
      access:
        mode: relay
        relay_id: example-bm-relay
        # Optional: a harness-local copy of the relay's admission plugin log
        # (tools/frp-grant-admission/README.md#the-log), kept current by the
        # deployment. The qualification checks each relayed lease's admission
        # in it; without it those checks skip, naming this field.
        # admission_log: /var/lib/example/frps-admission.log
      capacity: {vcpu_count: 2, ram_gb: 4, disk_gb: 40}
      # RFC8032 TEST1 public key: deterministic offline fixture, never use on any network.
      # Replace with the operator-verified machine key before running a real lane.
      ssh_host_public_key: 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINdamAGCsQq31Uv+08lkBzoO4XLz2qYjJa8CGmj3B1Ea'
      # Optional destructive cleanup qualification. The key path below is
      # harness-local, separate from connection.ssh_key_path inside the service.
      # Select e2e_bare_metal_bounded_cleanup only after reviewing the configured
      # disposable host, established bounded policy and operator route.
      # cleanup_qualification:
      #   policy_id: example-bounded-policy
      #   operator:
      #     host: 192.0.2.20
      #     port: 22
      #     user: operator
      #     key_path: /run/secrets/example-observer-key
