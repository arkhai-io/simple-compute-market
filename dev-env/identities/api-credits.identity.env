# Well-known deterministic development value. Not secret, never was, and
# MUST NOT be used on a public network. See README.md in this directory.
# The API-credits **storefront** signs with eip191, per `[identity]` in
# domains/apicredits/storefront/storefront.credits.toml. Do not confuse it
# with the API-credits **registry**, which signs with ed25519 and whose
# credential is api-credits-registry.ed25519 -- they are different
# principals and the schemes are not interchangeable.
ARKHAI_IDENTITY_CREDENTIAL=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
