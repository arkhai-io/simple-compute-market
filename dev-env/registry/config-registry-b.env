# Registry profile for the VM stack's private registry, `registry-b`, in the VM
# lane and the full local stack: ACTIVE_PROFILES=registry-b, read from
# CONFIG_DIRECTORY=/etc/arkhai/registry (compose.vms-local.yml).
#
# Public development values, never for a public network; see
# dev-env/identities/README.md. The identifier is the address of the signer
# credential compose.vms-local.yml mounts, dev-env/identities/registry-b.eip191.
REGISTRY_AUTHORITY_ID=registry-b
REGISTRY_AUTHORITY_SCHEME=eip191
REGISTRY_AUTHORITY_IDENTIFIER=0x15d34aaf54267db7d7c367839aaf71a00a2c6a65
REGISTRY_AUTHORITY_CREDENTIAL_FILE=/run/secrets/arkhai/registry-identity/credential
REGISTRY_DESCRIPTOR_BASE_URL=http://localhost:8082
REGISTRY_DESCRIPTOR_DISPLAY_NAME="Local Private VM Compute Registry"
REGISTRY_DESCRIPTOR_OPERATOR_IDENTITY="Arkhai local development"
REGISTRY_DESCRIPTOR_ACCESS_ACQUISITION_POINTER="http://localhost:8082/docs#/admin/create_api_key"

# A private registry: read and write gate independently, both on here, so every
# non-admin request must carry `Authorization: Bearer <key>` matching a
# non-revoked row in api_keys. The bootstrap key seeds one write-scoped row at
# startup (write implies read), so Bob's storefront publishes to registry-b on a
# fresh stack without an out-of-band mint step, and the buyer discovers from it
# with the same token. It must stay byte-equal to the [registry.auth] entries in
# dev-env/identities/bob.storefront.secrets.toml and buyer.config.toml and to the
# runner's `registry.bootstrap_api_key` (e2e-tests/config/config-docker.yml).
REGISTRY_REQUIRE_READ_API_KEY=true
REGISTRY_REQUIRE_WRITE_API_KEY=true
REGISTRY_ADMIN_API_KEY=development-registry-admin-key
REGISTRY_BOOTSTRAP_API_KEY=development-registry-bootstrap-key
