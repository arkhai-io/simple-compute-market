# Registry profile for the API-credit stack's registry, `api-credits-registry`, in
# the API-credit lane and the full local stack: ACTIVE_PROFILES=api-credits-registry,
# read from CONFIG_DIRECTORY=/etc/arkhai/registry (compose.apicredits-local.yml).
#
# Public development values, never for a public network; see
# dev-env/identities/README.md. The identifier is the Ed25519 identity of the
# signer credential compose.apicredits-local.yml mounts,
# dev-env/identities/api-credits-registry.ed25519.
REGISTRY_AUTHORITY_ID=api-credits-registry
REGISTRY_AUTHORITY_SCHEME=ed25519
REGISTRY_AUTHORITY_IDENTIFIER=_NUDENxVX6u4cMd0xzoYyQAt10QDI47bfnYnu2lTVho
REGISTRY_AUTHORITY_CREDENTIAL_FILE=/run/secrets/arkhai/registry-identity/credential
REGISTRY_DESCRIPTOR_BASE_URL=http://localhost:8090
REGISTRY_DESCRIPTOR_DISPLAY_NAME="Local API Credits Registry"
REGISTRY_DESCRIPTOR_OPERATOR_IDENTITY="Arkhai local development"
# The api_credits schema, which domains/apicredits/compose.yml mounts here, in
# place of the image's default compute specification.
REGISTRY_FILTER_SPEC_PATH=/app/filter-spec-apicredits.yaml
