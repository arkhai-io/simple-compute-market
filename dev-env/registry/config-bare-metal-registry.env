# Registry profile for the bare-metal lane's registry, `bare-metal-registry`:
# ACTIVE_PROFILES=bare-metal-registry,payments-lane, read from
# CONFIG_DIRECTORY=/etc/arkhai/registry (compose.bare-metal-local.yml).
#
# Public development values, never for a public network; see
# dev-env/identities/README.md, "The bare-metal lane". The identifier is the
# address of the signer credential the lane mounts,
# dev-env/identities/registry-a.eip191, reused under this authority id.
REGISTRY_AUTHORITY_ID=bare-metal-registry
REGISTRY_AUTHORITY_SCHEME=eip191
REGISTRY_AUTHORITY_IDENTIFIER=0x90f79bf6eb2c4f870365e785982e1f101e93b906
REGISTRY_AUTHORITY_CREDENTIAL_FILE=/run/secrets/arkhai/registry-identity/credential
REGISTRY_DESCRIPTOR_BASE_URL=http://bare-metal-registry:8080
REGISTRY_DESCRIPTOR_DISPLAY_NAME="Local Bare Metal Compute Registry"
REGISTRY_DESCRIPTOR_OPERATOR_IDENTITY="Arkhai local development"
