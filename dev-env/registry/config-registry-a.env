# Registry profile for the VM stack's public registry, `registry`, in the VM lane
# and the full local stack: ACTIVE_PROFILES=registry-a, read from
# CONFIG_DIRECTORY=/etc/arkhai/registry (compose.vms-local.yml).
#
# Public development values, never for a public network; see
# dev-env/identities/README.md. The identifier is the address of the signer
# credential compose.vms-local.yml mounts, dev-env/identities/registry-a.eip191.
REGISTRY_AUTHORITY_ID=registry-a
REGISTRY_AUTHORITY_SCHEME=eip191
REGISTRY_AUTHORITY_IDENTIFIER=0x90f79bf6eb2c4f870365e785982e1f101e93b906
REGISTRY_AUTHORITY_CREDENTIAL_FILE=/run/secrets/arkhai/registry-identity/credential
REGISTRY_DESCRIPTOR_BASE_URL=http://localhost:8080
REGISTRY_DESCRIPTOR_DISPLAY_NAME="Local VM Compute Registry"
REGISTRY_DESCRIPTOR_OPERATOR_IDENTITY="Arkhai local development"
