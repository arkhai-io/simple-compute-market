# Registry profile for the API-credit lane's compute-schema registry,
# `compute-registry`, which only that lane runs (compose.apicredits-lane.yml):
# ACTIVE_PROFILES=compute-registry,payments-lane, read from
# CONFIG_DIRECTORY=/etc/arkhai/registry. The image's default filter specification
# is the compute one, so this profile names none.
#
# Public development values, never for a public network; see
# dev-env/identities/README.md, "The API-credit lane". The identifier is the
# address of the signer credential the lane mounts,
# dev-env/identities/registry-a.eip191, reused under this authority id.
REGISTRY_AUTHORITY_ID=compute-registry
REGISTRY_AUTHORITY_SCHEME=eip191
REGISTRY_AUTHORITY_IDENTIFIER=0x90f79bf6eb2c4f870365e785982e1f101e93b906
REGISTRY_AUTHORITY_CREDENTIAL_FILE=/run/secrets/arkhai/registry-identity/credential
# No host port: the buyer reaches it on the lane's network, at the address its
# descriptor advertises.
REGISTRY_DESCRIPTOR_BASE_URL=http://compute-registry:8080
REGISTRY_DESCRIPTOR_DISPLAY_NAME="Local API-Credit Lane Compute Registry"
REGISTRY_DESCRIPTOR_OPERATOR_IDENTITY="Arkhai local development"
