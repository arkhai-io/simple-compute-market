{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arkhai:payments:wire-contract",
  "title": "arkhai-payments wire contract",
  "$defs": {
    "AccountId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Arkhai account UUID."
    },
    "Amount": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,37}$"
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiErrorCode"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "ApiErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "authentication_required",
        "caller_not_authorized",
        "account_not_found",
        "transaction_not_found",
        "approval_pending",
        "part_not_found",
        "mandate_expired",
        "invalid_mandate",
        "fee_mismatch",
        "unsupported_asset",
        "deal_mismatch",
        "attachment_not_found",
        "invalid_event",
        "request_id_reused",
        "hold_matured",
        "hold_not_reversible",
        "hold_not_extendable",
        "extension_not_found",
        "extension_closed",
        "insufficient_held_funds",
        "insufficient_funds",
        "card_debt",
        "transaction_stopped",
        "account_directory_unavailable",
        "ledger_unavailable",
        "connect_account_not_found",
        "withdrawal_not_found",
        "insufficient_withdrawable",
        "withdrawal_too_small",
        "payouts_not_enabled",
        "stripe_unavailable",
        "cash_database_unavailable",
        "top_up_limit",
        "payment_method_not_found",
        "top_up_not_found",
        "faucet_limit",
        "internal_error"
      ]
    },
    "ApprovalRequest": {
      "type": "object",
      "properties": {
        "mandate": {
          "$ref": "#/$defs/Mandate"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DealAttachment"
          }
        }
      },
      "required": [
        "mandate"
      ],
      "additionalProperties": false
    },
    "Asset": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,16}(\\/\\d{1,6})?$"
    },
    "Authorities": {
      "anyOf": [
        {
          "$ref": "#/$defs/OnceAuthorities"
        },
        {
          "$ref": "#/$defs/RateAuthorities"
        }
      ]
    },
    "AutoRechargeDisabled": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "AutoRechargeEnabled": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": true
        },
        "threshold": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)$"
        },
        "amountCents": {
          "$ref": "#/$defs/TopUpAmountCents"
        },
        "paymentMethod": {
          "$ref": "#/$defs/PaymentMethodId"
        }
      },
      "required": [
        "enabled",
        "threshold",
        "amountCents"
      ],
      "additionalProperties": false
    },
    "AutoRechargeEnabledInput": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": true
        },
        "threshold": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)$"
        },
        "amountCents": {
          "$ref": "#/$defs/TopUpAmountCents"
        },
        "paymentMethod": {
          "$ref": "#/$defs/PaymentMethodId"
        }
      },
      "required": [
        "enabled",
        "amountCents"
      ],
      "additionalProperties": false
    },
    "AutoRechargeInput": {
      "oneOf": [
        {
          "$ref": "#/$defs/AutoRechargeDisabled"
        },
        {
          "$ref": "#/$defs/AutoRechargeEnabledInput"
        }
      ]
    },
    "AutoRechargeResponse": {
      "type": "object",
      "properties": {
        "settings": {
          "$ref": "#/$defs/AutoRechargeSettings"
        },
        "recommendedThreshold": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)$"
        }
      },
      "required": [
        "settings",
        "recommendedThreshold"
      ],
      "additionalProperties": false
    },
    "AutoRechargeSettings": {
      "oneOf": [
        {
          "$ref": "#/$defs/AutoRechargeDisabled"
        },
        {
          "$ref": "#/$defs/AutoRechargeEnabled"
        }
      ]
    },
    "Balance": {
      "type": "object",
      "properties": {
        "available": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Asset"
          },
          "additionalProperties": {
            "$ref": "#/$defs/BalanceAvailable"
          },
          "description": "Spendable balances by asset; outgoing escrow has already left available."
        },
        "held": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BalanceHold"
          },
          "description": "Unreleased incoming holds where this account is the payee. Outgoing payer escrow is excluded and appears only in that transaction's signed snapshot."
        }
      },
      "required": [
        "available",
        "held"
      ],
      "additionalProperties": false
    },
    "BalanceAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$"
    },
    "BalanceAvailable": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,37})$"
    },
    "BalanceHold": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimedBalanceHold"
        },
        {
          "$ref": "#/$defs/UntilStopBalanceHold"
        },
        {
          "$ref": "#/$defs/UntilLiftBalanceHold"
        }
      ],
      "description": "Incoming money held for the payee until release."
    },
    "BillingPortalRequest": {
      "type": "object",
      "properties": {
        "returnUrl": {
          "$ref": "#/$defs/HttpUrl"
        }
      },
      "required": [
        "returnUrl"
      ],
      "additionalProperties": false
    },
    "BillingPortalSession": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/$defs/HttpUrl"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "CheckoutTopUpRequest": {
      "type": "object",
      "properties": {
        "amountCents": {
          "$ref": "#/$defs/TopUpAmountCents"
        },
        "successUrl": {
          "$ref": "#/$defs/HttpUrl"
        },
        "cancelUrl": {
          "$ref": "#/$defs/HttpUrl"
        }
      },
      "required": [
        "amountCents",
        "successUrl",
        "cancelUrl"
      ],
      "additionalProperties": false
    },
    "ConnectedAccountId": {
      "type": "string",
      "pattern": "^acct_[A-Za-z0-9]+$"
    },
    "ConnectStatus": {
      "type": "object",
      "properties": {
        "connectedAccount": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectedAccountId"
            },
            {
              "type": "null"
            }
          ]
        },
        "payoutsEnabled": {
          "type": "boolean"
        },
        "transfers": {
          "$ref": "#/$defs/ConnectTransferStatus"
        },
        "detailsSubmitted": {
          "type": "boolean"
        }
      },
      "required": [
        "connectedAccount",
        "payoutsEnabled",
        "transfers",
        "detailsSubmitted"
      ],
      "additionalProperties": false
    },
    "ConnectTransferStatus": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending",
        "unrequested"
      ]
    },
    "DealAttachment": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "deal"
        },
        "content": {
          "$ref": "#/$defs/DealContent"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "content"
      ],
      "additionalProperties": false
    },
    "DealCommitment": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "DealContent": {},
    "Duration": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
    },
    "EventCommand": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LifecycleKind"
        },
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "until": {
          "description": "Extension deadline in Unix seconds, strictly after receipt; absent freezes until lift or the cap.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ref": {
          "description": "Sequence of the extend event to lift on this part.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "at": {
          "description": "Requested stop time in Unix seconds; the sender’s notice may move it later.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "partialPeriod": {
          "$ref": "#/$defs/PartialPeriod"
        },
        "payload": {
          "description": "Opaque JSON, recorded and never interpreted."
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "EventRequest": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountId"
        },
        "requestId": {
          "$ref": "#/$defs/RequestId"
        },
        "event": {
          "$ref": "#/$defs/LifecycleEvent"
        }
      },
      "required": [
        "account",
        "requestId",
        "event"
      ],
      "additionalProperties": false
    },
    "FaucetAmountCents": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[1-9][0-9]*$"
    },
    "FaucetCredit": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountId"
        },
        "amountCents": {
          "$ref": "#/$defs/FaucetAmountCents"
        },
        "ledger": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "account",
        "amountCents",
        "ledger"
      ],
      "additionalProperties": false
    },
    "FaucetRequest": {
      "type": "object",
      "properties": {
        "amountCents": {
          "$ref": "#/$defs/FaucetAmountCents"
        }
      },
      "required": [
        "amountCents"
      ],
      "additionalProperties": false
    },
    "Fee": {
      "type": "object",
      "properties": {
        "bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "bps"
      ],
      "additionalProperties": false,
      "description": "Service fee in basis points, pinned in the mandate; must equal current policy."
    },
    "Health": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Hold": {
      "anyOf": [
        {
          "$ref": "#/$defs/HoldFor"
        },
        {
          "$ref": "#/$defs/HoldAfterStop"
        }
      ],
      "description": "How long a part's money stays reversible and uncollectable by the payee."
    },
    "HoldAfterStop": {
      "type": "object",
      "properties": {
        "afterStop": {
          "$ref": "#/$defs/Duration"
        }
      },
      "required": [
        "afterStop"
      ],
      "additionalProperties": false,
      "description": "Collectable this long after this part stops."
    },
    "HoldExtension": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "HoldFor": {
      "type": "object",
      "properties": {
        "for": {
          "$ref": "#/$defs/Duration"
        }
      },
      "required": [
        "for"
      ],
      "additionalProperties": false,
      "description": "Collectable this long after earning: approval for once, period end or stop for rate."
    },
    "HttpUrl": {
      "type": "string",
      "pattern": "^https?:\\/\\/[^\\s]+$"
    },
    "Identity": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "const": "ed25519"
        },
        "identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        }
      },
      "required": [
        "scheme",
        "identifier"
      ],
      "additionalProperties": false,
      "description": "Canonical unpadded base64url of a 32-byte Ed25519 public key."
    },
    "LifecycleEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LifecycleKind"
        },
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "until": {
          "description": "Extension deadline in Unix seconds, strictly after receipt; absent freezes until lift or the cap.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ref": {
          "description": "Sequence of the extend event to lift on this part.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "at": {
          "description": "Requested stop time in Unix seconds; the sender’s notice may move it later.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "partialPeriod": {
          "$ref": "#/$defs/PartialPeriod"
        },
        "payload": {
          "description": "Opaque JSON, recorded and never interpreted."
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "LifecycleKind": {
      "type": "string",
      "enum": [
        "start",
        "stop",
        "reverse",
        "extend",
        "lift"
      ]
    },
    "Mandate": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/AccountId"
        },
        "to": {
          "$ref": "#/$defs/AccountId"
        },
        "parts": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "deal": {
          "$ref": "#/$defs/DealCommitment"
        },
        "fee": {
          "$ref": "#/$defs/Fee"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "expires": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix seconds after which approval is refused."
        }
      },
      "required": [
        "from",
        "to",
        "parts",
        "deal",
        "fee",
        "nonce",
        "expires"
      ],
      "additionalProperties": false,
      "description": "Explicit terms submitted for approval in an authenticated request."
    },
    "MinorUnits": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$"
    },
    "OnboardingLink": {
      "type": "object",
      "properties": {
        "connectedAccount": {
          "$ref": "#/$defs/ConnectedAccountId"
        },
        "url": {
          "$ref": "#/$defs/HttpUrl"
        },
        "expiresAt": {
          "$ref": "#/$defs/UnixSeconds"
        }
      },
      "required": [
        "connectedAccount",
        "url",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "OnboardingRequest": {
      "type": "object",
      "properties": {
        "refreshUrl": {
          "$ref": "#/$defs/HttpUrl"
        },
        "returnUrl": {
          "$ref": "#/$defs/HttpUrl"
        }
      },
      "required": [
        "refreshUrl",
        "returnUrl"
      ],
      "additionalProperties": false
    },
    "OnceAuthorities": {
      "type": "object",
      "properties": {
        "stop": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StopAuthority"
          }
        },
        "reverse": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountId"
          }
        },
        "extend": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "required": [
        "stop",
        "reverse",
        "extend"
      ],
      "additionalProperties": false
    },
    "OncePart": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "once"
        },
        "asset": {
          "$ref": "#/$defs/Asset"
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "hold": {
          "$ref": "#/$defs/Hold"
        },
        "authorities": {
          "$ref": "#/$defs/OnceAuthorities"
        },
        "maxHoldExtension": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "$ref": "#/$defs/PartEnd"
        }
      },
      "required": [
        "kind",
        "asset",
        "amount",
        "hold",
        "authorities",
        "maxHoldExtension"
      ],
      "additionalProperties": false,
      "description": "A fixed amount, debited and credited (held) at approval."
    },
    "Part": {
      "oneOf": [
        {
          "$ref": "#/$defs/OncePart"
        },
        {
          "$ref": "#/$defs/RatePart"
        }
      ]
    },
    "PartEnd": {
      "type": "object",
      "properties": {
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "partialPeriod": {
          "$ref": "#/$defs/PartialPeriod"
        }
      },
      "required": [
        "at",
        "partialPeriod"
      ],
      "additionalProperties": false,
      "description": "Automatic terms-stop deadline and cut-period rule. Execution uses max(at, approvedAt); stored mandate bytes stay unchanged."
    },
    "PartialPeriod": {
      "type": "string",
      "enum": [
        "charged",
        "returned",
        "prorated"
      ]
    },
    "PartSnapshot": {
      "type": "object",
      "properties": {
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "asset": {
          "$ref": "#/$defs/Asset"
        },
        "gross": {
          "$ref": "#/$defs/MinorUnits"
        },
        "held": {
          "$ref": "#/$defs/MinorUnits"
        },
        "released": {
          "$ref": "#/$defs/MinorUnits"
        },
        "reversed": {
          "$ref": "#/$defs/MinorUnits"
        },
        "reserved": {
          "$ref": "#/$defs/MinorUnits"
        },
        "refunded": {
          "$ref": "#/$defs/MinorUnits"
        },
        "rate": {
          "$ref": "#/$defs/RateProgress"
        },
        "started": {
          "description": "The rate part’s first start, in Unix seconds.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "description": "Effective terms end: max(mandate end.at, approval instant), with the mandate's partial-period rule. The stored mandate is unchanged.",
          "$ref": "#/$defs/PartEnd"
        },
        "stop": {
          "$ref": "#/$defs/PartStop"
        },
        "pendingStop": {
          "$ref": "#/$defs/PendingStop"
        },
        "feePaid": {
          "$ref": "#/$defs/MinorUnits"
        },
        "hold": {
          "$ref": "#/$defs/Hold"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HoldExtension"
          }
        },
        "releaseAt": {
          "description": "Effective UTC maturity, including open extensions and the cap; absent while unbounded or awaiting stop.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PartState"
        }
      },
      "required": [
        "part",
        "asset",
        "gross",
        "held",
        "released",
        "reversed",
        "feePaid",
        "hold",
        "extensions",
        "status"
      ],
      "additionalProperties": false
    },
    "PartState": {
      "type": "string",
      "enum": [
        "held",
        "released",
        "reversed",
        "settled"
      ]
    },
    "PartStop": {
      "type": "object",
      "properties": {
        "effectiveAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cause": {
          "$ref": "#/$defs/StopCause"
        },
        "partialPeriod": {
          "$ref": "#/$defs/PartialPeriod"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "settled": {
          "$ref": "#/$defs/SettledPart"
        }
      },
      "required": [
        "effectiveAt",
        "cause",
        "partialPeriod",
        "sequence",
        "settled"
      ],
      "additionalProperties": false
    },
    "PaymentMethodId": {
      "type": "string",
      "pattern": "^pm_[A-Za-z0-9]+$"
    },
    "PayoutAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$"
    },
    "PayoutBalance": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string",
          "const": "USD/6"
        },
        "available": {
          "$ref": "#/$defs/BalanceAvailable"
        },
        "withdrawable": {
          "$ref": "#/$defs/PayoutAmount"
        }
      },
      "required": [
        "asset",
        "available",
        "withdrawable"
      ],
      "additionalProperties": false
    },
    "PendingStop": {
      "type": "object",
      "properties": {
