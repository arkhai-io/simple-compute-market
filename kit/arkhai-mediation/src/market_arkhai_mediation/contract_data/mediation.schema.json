{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arkhai:mediation:v1",
  "title": "arkhai.mediation.v1 wire contract",
  "$defs": {
    "AccountId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Arkhai account UUID."
    },
    "AdjudicationTerms": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "dispute": {
          "$ref": "#/$defs/DisputeAuthority"
        },
        "dispute_window_seconds": {
          "$ref": "#/$defs/WindowSeconds"
        },
        "case_hold_max_seconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowSeconds"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "dispute",
        "dispute_window_seconds",
        "case_hold_max_seconds"
      ],
      "additionalProperties": {}
    },
    "AgreementProjection": {
      "type": "object",
      "properties": {
        "settlement": {
          "$ref": "#/$defs/MappingSettlement"
        },
        "start_utc": {
          "$ref": "#/$defs/AgreementStart"
        },
        "duration_seconds": {
          "$ref": "#/$defs/TermSeconds"
        }
      },
      "required": [
        "settlement"
      ],
      "additionalProperties": {},
      "description": "Projection of the hash-checked SCM Agreement carried in the filing, not a replacement Agreement schema. Extra domain fields are ignored. Timed terms need start_utc and duration_seconds, the term's only source (open-ended terms resolve it at acceptance). Missing/unreadable terms are reported for operator handling."
    },
    "AgreementStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[0-2]\\d:[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|\\+00:00)$",
      "description": "RFC 3339 UTC start_utc; mapping validates the date and microsecond precision and rounds the payment boundary up to whole seconds."
    },
    "Amount": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,37}$"
    },
    "Append": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceAppend"
        },
        {
          "$ref": "#/$defs/ConcurrenceAppend"
        }
      ],
      "description": "Either party may append evidence to an open case; only the payee may append concurrence. At least nonempty items or concurrence is required. Idempotency-Key is required; retries return the same record. Omitted items are recorded as an empty array."
    },
    "AppendAccepted": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "accepted"
        },
        "record": {
          "$ref": "#/$defs/SignedRecordEntry"
        }
      },
      "required": [
        "status",
        "record"
      ],
      "additionalProperties": false
    },
    "AppendAnswer": {
      "oneOf": [
        {
          "$ref": "#/$defs/AppendAccepted"
        },
        {
          "$ref": "#/$defs/AppendRefused"
        },
        {
          "$ref": "#/$defs/MediationFailure"
        }
      ]
    },
    "AppendedEntry": {
      "type": "object",
      "properties": {
        "agreement": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "transaction": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "case_ref": {
          "$ref": "#/$defs/CaseRef"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Per Agreement across ALL cases; starts at 1. Never a per-case cursor."
        },
        "record_ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "actor": {
          "$ref": "#/$defs/AccountId"
        },
        "at": {
          "$ref": "#/$defs/MediationTime"
        },
        "parts": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartProtection"
          }
        },
        "issuer": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "type": "string",
          "const": "appended"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          }
        },
        "concurrence": {
          "$ref": "#/$defs/SignedDeliveryEndClaim"
        }
      },
      "required": [
        "agreement",
        "transaction",
        "case_ref",
        "sequence",
        "record_ref",
        "actor",
        "at",
        "parts",
        "issuer",
        "kind",
        "items"
      ],
      "additionalProperties": false
    },
    "AppendRefused": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "rejected"
        },
        "reason": {
          "type": "string",
          "enum": [
            "case_not_found",
            "case_closed",
            "actor_not_party"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "message"
      ],
      "additionalProperties": false
    },
    "AwardEffect": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "award"
        },
        "part": {
          "$ref": "#/$defs/PartIndex"
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        }
      },
      "required": [
        "kind",
        "part",
        "amount"
      ],
      "additionalProperties": false,
      "description": "Reserved for bond support. Not executable on arkhai.payments.v1."
    },
    "CaseAnswer": {
      "type": "object",
      "properties": {
        "case_ref": {
          "$ref": "#/$defs/CaseRef"
        },
        "transaction": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "agreement": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "applying",
            "closed"
          ]
        },
        "parts": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartProtection"
          }
        }
      },
      "required": [
        "case_ref",
        "transaction",
        "agreement",
        "state",
        "parts"
      ],
      "additionalProperties": false,
      "description": "Mediation's own answer, only after every part's protection is determined. The Agreement id is mandate.deal (SHA-256 of JCS Agreement)."
    },
    "CaseConcurrencyPolicy": {
      "type": "object",
      "properties": {
        "repeated_cases": {
          "type": "string",
          "const": "allowed"
        },
        "concurrent_cases": {
          "type": "string",
          "const": "independent"
        },
        "extensions": {
          "type": "string",
          "const": "per_case"
        },
        "case_hold_release": {
          "type": "string",
          "const": "after_all_case_extensions_lifted"
        },
        "rulings": {
          "type": "string",
          "const": "net_prior_effects"
        }
      },
      "required": [
        "repeated_cases",
        "concurrent_cases",
        "extensions",
        "case_hold_release",
        "rulings"
      ],
      "additionalProperties": false,
      "description": "Cases on one Agreement are independent; lifting one case never lifts another case’s extensions. Original payments release terms still apply."
    },
    "CaseDismissalPolicy": {
      "type": "object",
      "properties": {
        "automatic": {
          "type": "string",
          "const": "all_parts_definitively_not_held_at_filing"
        },
        "ungrounded": {
          "type": "string",
          "const": "operator_may_dismiss"
        },
        "inactivity_timeout_seconds": {
          "type": "null"
        },
        "operator_response_max_seconds": {
          "type": "null"
        }
      },
      "required": [
        "automatic",
        "ungrounded",
        "inactivity_timeout_seconds",
        "operator_response_max_seconds"
      ],
      "additionalProperties": false,
      "description": "Automatic dismissal only when payments can no longer act on any part. Operators may dismiss ungrounded cases; silence alone never dismisses a case and has no response bound."
    },
    "CaseRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Opaque mediation case reference; not a credential."
    },
    "ClosedEntry": {
      "anyOf": [
        {
          "$ref": "#/$defs/NothingHeldClosedEntry"
        },
        {
          "$ref": "#/$defs/DecidedClosedEntry"
        }
      ]
    },
    "ConcurrenceAppend": {
      "type": "object",
      "properties": {
        "case_ref": {
          "$ref": "#/$defs/CaseRef"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          }
        },
        "concurrence": {
          "$ref": "#/$defs/SignedDeliveryEndClaim"
        }
      },
      "required": [
        "case_ref",
        "concurrence"
      ],
      "additionalProperties": false
    },
    "DecidedClosedEntry": {
      "type": "object",
      "properties": {
        "agreement": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "transaction": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "case_ref": {
          "$ref": "#/$defs/CaseRef"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Per Agreement across ALL cases; starts at 1. Never a per-case cursor."
        },
        "record_ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "actor": {
          "$ref": "#/$defs/AccountId"
        },
        "at": {
          "$ref": "#/$defs/MediationTime"
        },
        "parts": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartProtection"
          }
        },
        "issuer": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "type": "string",
          "const": "closed"
        },
        "reason": {
          "type": "string",
          "enum": [
            "ruled",
            "dismissed"
          ]
        },
        "basis": {
          "$ref": "#/$defs/RulingBasis"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        }
      },
      "required": [
        "agreement",
        "transaction",
        "case_ref",
        "sequence",
        "record_ref",
        "actor",
        "at",
        "parts",
        "issuer",
        "kind",
        "reason",
        "basis",
        "outcome"
      ],
      "additionalProperties": false,
      "description": "Final decision after effects apply and this case’s extensions are lifted; operator dismissal has an empty outcome."
    },
    "DeliveryEndClaim": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "delivery_end"
        },
        "ended_at": {
          "$ref": "#/$defs/MediationTime"
        },
        "delivered": {
          "type": "boolean"
        },
        "cause": {
          "type": "string",
          "enum": [
            "payee",
            "payer"
          ]
        }
      },
      "required": [
        "kind",
        "ended_at",
        "delivered",
        "cause"
      ],
      "additionalProperties": false
    },
    "Description": {
      "type": "object",
      "properties": {
        "dispute": {
          "$ref": "#/$defs/DisputeAuthority"
        },
        "contact": {
          "type": "string",
          "pattern": "^(?:mailto:|https:)",
          "description": "Where parties can reach the authority's people; a mailto: or https: URI."
        },
        "payment_mechanisms": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "const": "arkhai.payments.v1"
          }
        },
        "minimum_dispute_window_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minimum_case_hold_max_seconds": {
          "type": "null"
        },
        "filing_fee": {
          "type": "string",
          "const": "0"
        },
        "filing_deposit": {
          "type": "string",
          "const": "0"
        },
        "case_concurrency": {
          "$ref": "#/$defs/CaseConcurrencyPolicy"
        },
        "case_dismissal": {
          "$ref": "#/$defs/CaseDismissalPolicy"
        },
        "record_retention": {
          "$ref": "#/$defs/RecordRetentionPolicy"
        },
        "automatic_rulings": {
          "type": "string",
          "const": "payee_endorsed_delivery_end_once_per_agreement"
        },
        "default_outcome": {
          "type": "null"
        },
        "agreement_projection": {
          "type": "string",
          "const": "AgreementProjection"
        }
      },
      "required": [
        "dispute",
        "contact",
        "payment_mechanisms",
        "minimum_dispute_window_seconds",
        "minimum_case_hold_max_seconds",
        "filing_fee",
        "filing_deposit",
        "case_concurrency",
        "case_dismissal",
        "record_retention",
        "automatic_rulings",
        "default_outcome",
        "agreement_projection"
      ],
      "additionalProperties": false,
      "description": "Public advertisement. Null minimum case-hold cap requires unbounded holds in new offers. No default ruling on silence; operator review unless a mechanical rule applies."
    },
    "DisputeAuthority": {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "const": "arkhai.mediation.v1"
        },
        "origin": {
          "type": "string",
          "pattern": "^https?:\\/\\/[^/?#\\s]+(?::[0-9]+)?$"
        },
        "account": {
          "$ref": "#/$defs/AccountId"
        },
        "record_key": {
          "$ref": "#/$defs/RecordKey"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/MediationValue"
          }
        }
      },
      "required": [
        "interface",
        "origin",
        "account",
        "record_key",
        "params"
      ],
      "additionalProperties": false,
      "description": "The authority pinned in the selected option's lifecycle.adjudication.dispute."
    },
    "Duration": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
    },
    "EarlyTerminationProjection": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "premature_stop_penalty": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,37})$"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": {},
      "description": "Only premature_stop_penalty (canonical decimal asset minor units; absent or 0 = none) is read here. Entitlements, settles_through and exposure remain the payment adapter's responsibility and pass through unvalidated."
    },
    "Effect": {
      "oneOf": [
        {
          "$ref": "#/$defs/ReverseEffect"
        },
        {
          "$ref": "#/$defs/StopEffect"
        },
        {
          "$ref": "#/$defs/EndDeliveryEffect"
        },
        {
          "$ref": "#/$defs/PenaltyEffect"
        },
        {
          "$ref": "#/$defs/AwardEffect"
        }
      ]
    },
    "EffectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable within the Agreement, including across application retries."
    },
    "EffectsRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "effects"
        },
        "effects": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Effect"
          }
        }
      },
      "required": [
        "kind",
        "effects"
      ],
      "additionalProperties": false
    },
    "EndDeliveryEffect": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "end_delivery"
        },
        "at": {
          "$ref": "#/$defs/MediationTime"
        }
      },
      "required": [
        "kind",
        "at"
      ],
      "additionalProperties": false,
      "description": "Final delivery end at T <= ruling time; consumed from the signed record, not sent to payments."
    },
    "EvidenceAppend": {
      "type": "object",
      "properties": {
        "case_ref": {
          "$ref": "#/$defs/CaseRef"
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          }
        },
        "concurrence": {
          "$ref": "#/$defs/SignedDeliveryEndClaim"
        }
      },
      "required": [
        "case_ref",
        "items"
      ],
      "additionalProperties": false
    },
    "EvidenceItem": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "at": {
          "$ref": "#/$defs/MediationTime"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]|[A-Za-z0-9_-][AQgw])?$"
        }
      },
      "required": [
        "kind",
        "producer",
        "at",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "description": "Exact original bytes (including a signed authority record), unpadded base64url; sha256 is the lowercase hash of those decoded bytes. Producer/time are the submitter's claims; the entry actor is authenticated. Ordered, not normalized or re-signed."
    },
    "ExpectedAfterStop": {
      "type": "object",
      "properties": {
        "afterStop": {
          "$ref": "#/$defs/Duration"
        }
      },
      "required": [
        "afterStop"
      ],
      "additionalProperties": false
    },
    "ExpectedAuthorities": {
      "type": "object",
      "properties": {
        "stop": {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StopAuthority"
          }
        },
        "reverse": {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountId"
          }
        },
        "extend": {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "required": [
        "stop",
        "reverse",
        "extend"
      ],
      "additionalProperties": false,
      "description": "stop is required on rate parts; reverse is required on every part. These are mediation entries, not exhaustive lists. extend is exclusive to mediation. This projection does not derive parties' start/stop/refund rights."
    },
    "ExpectedLifecycle": {
      "type": "object",
      "properties": {
        "end": {
          "$ref": "#/$defs/MediationTime"
        },
        "hold": {
          "$ref": "#/$defs/ExpectedAfterStop"
        },
        "maxHoldExtension": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorities": {
          "$ref": "#/$defs/ExpectedAuthorities"
        }
      },
      "required": [
        "end",
        "hold",
        "maxHoldExtension",
        "authorities"
      ],
      "additionalProperties": false,
      "description": "Required on EVERY once/rate part; end is the latest permitted absolute part end, independent of rate start. Earlier mandate ends (including setup at Agreement start) are allowed. Payments snapshots expose the effective end, max(mandate end, approval). Payee-cause delivery-end claims use that effective end for ordinary once parts. Setup parts (mandate end at or before Agreement start) are reversed in full iff delivered is false, independent of approval time."
    },
    "FiledEntry": {
      "type": "object",
      "properties": {
        "agreement": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "transaction": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "case_ref": {
          "$ref": "#/$defs/CaseRef"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Per Agreement across ALL cases; starts at 1. Never a per-case cursor."
        },
        "record_ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "actor": {
          "$ref": "#/$defs/AccountId"
        },
        "at": {
          "$ref": "#/$defs/MediationTime"
        },
        "parts": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartProtection"
          }
        },
        "issuer": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "type": "string",
          "const": "filed"
        },
        "filing": {
          "$ref": "#/$defs/Filing"
        }
      },
      "required": [
        "agreement",
        "transaction",
        "case_ref",
        "sequence",
        "record_ref",
        "actor",
        "at",
        "parts",
        "issuer",
        "kind",
        "filing"
      ],
      "additionalProperties": false
    },
    "Filing": {
      "type": "object",
      "properties": {
        "transaction": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "agreement": {
          "$ref": "#/$defs/MediationValue"
        },
        "request": {
          "$ref": "#/$defs/Request"
        },
        "concurrence": {
          "$ref": "#/$defs/SignedDeliveryEndClaim"
        },
        "claim": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          }
        }
      },
      "required": [
        "transaction",
        "agreement",
        "request",
        "claim",
        "items"
      ],
      "additionalProperties": false,
      "description": "Authenticated party filing carrying the exact Agreement whose JCS SHA-256 must equal mandate.deal. Payments attachments are not read. Idempotency-Key is required."
    },
    "FilingAccepted": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "accepted"
        },
        "case": {
          "$ref": "#/$defs/CaseAnswer"
        }
      },
      "required": [
        "status",
        "case"
      ],
      "additionalProperties": false
    },
    "FilingAnswer": {
      "oneOf": [
        {
          "$ref": "#/$defs/FilingAccepted"
        },
        {
          "$ref": "#/$defs/FilingRefused"
        },
        {
          "$ref": "#/$defs/FilingPending"
        },
        {
