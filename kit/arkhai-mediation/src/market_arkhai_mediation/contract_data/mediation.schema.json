      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/WebhookEndpointId"
        },
        "url": {
          "$ref": "#/$defs/WebhookUrl"
        },
        "secret": {
          "$ref": "#/$defs/WebhookSecret"
        }
      },
      "required": [
        "id",
        "url",
        "secret"
      ],
      "additionalProperties": false
    },
    "WebhookEndpointId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "WebhookEndpointRequest": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/$defs/WebhookUrl"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "WebhookEndpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WebhookEndpoint"
      }
    },
    "WebhookSecret": {
      "type": "string",
      "pattern": "^whsec_[A-Za-z0-9+/]{43}=$"
    },
    "WebhookUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?:\\/\\/[^\\s]+$",
      "description": "HTTPS receiver URL; development permits HTTP loopback only."
    },
    "WindowSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
