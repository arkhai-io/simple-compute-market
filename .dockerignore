# Keep repo-root build contexts small: never ship venvs, git history,
# caches, or local state into images. (.dist/ must stay included — the
# Dockerfiles resolve internal wheels from it via --find-links.)
.git
**/.venv
**/__pycache__
**/._*
**/.DS_Store
**/.pytest_cache
.uv-cache
.snapshot
**/node_modules
**/target
dev-env/state
# A real host's description, rendered into the e2e config directory on an
# operator's machine; an image built from that checkout must not carry it.
e2e-tests/config/config-real-vm-target.yml
